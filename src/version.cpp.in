#include "version.hpp"

namespace tenes {

const char *version() { return "@TENES_VERSION@"; }
const char *git_hash() { return "@TENES_GIT_HASH@"; }
bool git_dirty() { return @TENES_GIT_DIRTY@; }

std::string version_string() {
  const std::string hash = git_hash();
