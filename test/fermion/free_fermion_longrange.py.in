# Items 3 and 6 of the T4 contract of
# docs/superpowers/plans/2026-09-25-fermion-longrange-measure.md
# (design: docs/superpowers/specs/2026-09-25-fermion-longrange-measure-design.md):
# long-range two-site observables and the correlation function of free
# spinless fermions at half filling, through the standard pipeline
#
#   simple.toml -> tenes_simple -> std.toml -> tenes_std -> input.toml -> tenes
#
# compared with the momentum integral
#
#   <c^dag_0 c_r> = int d^2k / (2 pi)^2  e^{i k.r} n(k),
#   n(k) = theta(-eps(k)),  eps(k) = -2 t (cos kx + cos ky),  mu = 0.
#
# The physics is that of FreeFermionSimple (t = 1, mu = 0, D = 2, chi = 8,
# tau = 0.01, num_step = 1000, seed = 11, noise = 1.0, L_sub = [2, 2]); the
# simple.toml only adds [correlation] r_max = 6, without `operators`, so the
# default operator list of tenes_simple is what gets measured.  The std.toml
# written by tenes_simple is extended with three two-site observables before
# tenes_std sees it (tenes_simple only emits nearest-neighbour ones):
#
#   hopping_longrange  explicit elements of tenes_simple's own "hopping"
#                      (c^dag_s c_t + c^dag_t c_s) on the displacements of
#                      contract item 3 plus the two nearest-neighbour ones
#   cdag_c             ops = [cdag, c]  (contract items 1 and 2: the one-site
#                      operators exist and tenes_std accepts the ops form)
#   c_cdag             ops = [c, cdag]
#
# What is checked, in this order:
#
#   1. the schema: one-site operators 0: n, 1: cdag, 2: c, and the default
#      [correlation] operators [[0, 0], [1, 2]] in input.toml;
#   2. no "CTM did not converge" and no norm warning;
#   3. the one-site values of cdag and c are exactly 0 (design section 4.1);
#   4. identities that hold for ANY state, per site, between numbers that
#      come out of different code paths of one run.  To rounding (TIGHT_TOL):
#      window measurement against transfer-matrix correlation, the explicit
#      hopping operator against the sum of the two ops-form products, and
#      [c, cdag] against -[cdag, c] on the reversed bond.  To the convergence
#      of the CTM environment (ENV_TOL): the reversed bond against the
#      forward one (hermiticity), and the nearest-neighbour hopping of
#      tenes_simple (the pre-existing bundled-k path) against the r = 1
#      correlation;
#   5. the analytic values (see ANALYTIC_REL);
#   6. with --nproc N (N > 1, the MPI registration of contract item 6) the
#      same input.toml is also run on one process and every output file of
#      the N-process run has to agree with it (see MPI_TOL);
#   7. the golden files, with the rtol / atol of test/fulltest.py.in.
#
# Golden files: test/data/output_FreeFermionLongRange/{density,onesite_obs,
# twosite_obs,correlation}.dat in the SOURCE tree.  They do not exist until
# the implementation is in place, and the test fails while they are missing.
# To (re)generate them, on purpose only:
#
#   TENES_UPDATE_FERMION_LONGRANGE_GOLDEN=1 ctest -R '^FreeFermionLongRange$'
#
# in the build tree.  The update mode still runs checks 1-5 and refuses to
# write anything if one of them fails; it writes the output of the
# one-process run.  The --nproc registration never writes golden files.

import functools
import os
import shutil
import subprocess
import sys
from os.path import join

import numpy as np
import toml

TENES_SIMPLE = join("@CMAKE_BINARY_DIR@", "tool", "tenes_simple")
TENES_STD = join("@CMAKE_BINARY_DIR@", "tool", "tenes_std")
TENES = join("@CMAKE_BINARY_DIR@", "src", "tenes")
MPIEXEC = "@MPIEXEC@"

NAME = "FreeFermionLongRange"
GOLDEN_DIR = join("@CMAKE_CURRENT_SOURCE_DIR@", "data", "output_" + NAME)
GOLDEN_FILES = ("density.dat", "onesite_obs.dat", "twosite_obs.dat", "correlation.dat")
UPDATE_GOLDEN_ENV = "TENES_UPDATE_FERMION_LONGRANGE_GOLDEN"

# test/fulltest.py.in
RTOL = 1.0e-3
ATOL = 1.0e-4

T = 1.0
R_MAX = 6
# (dx, dy) of contract item 3
CONTRACT_DISPLACEMENTS = [(2, 0), (1, 1), (2, 1), (3, 0)]
NEAREST = [(1, 0), (0, 1)]
# straight bonds that the correlation function also measures (r = 1 .. 3)
STRAIGHT = [(1, 0), (2, 0), (3, 0), (0, 1), (0, 2), (0, 3)]
L_SUB = (2, 2)
NSITES = L_SUB[0] * L_SUB[1]

SIMPLE_TOML = """
[parameter.general]
is_real = true
output = "output"

[parameter.simple_update]
tau = 0.01
num_step = 1000

[parameter.ctm]
dimension = 8
convergence_epsilon = 1.0e-8
iteration_max = 100

[parameter.random]
seed = 11

[lattice]
type = "square lattice"
L = 2
W = 2
virtual_dim = 2
initial = "random"
noise = 1.0

[model]
type = "spinless fermion"
t = 1.0
mu = 0.0

[correlation]
r_max = {r_max}
""".format(
    r_max=R_MAX
)


# ---------------------------------------------------------------------------
# The analytic reference
# ---------------------------------------------------------------------------


@functools.lru_cache(maxsize=None)
def exact_hopping(displacement, nk=2048):
    """<c^dag_0 c_r> of the half-filled Fermi sea on an nk x nk torus.

    The momenta are k = 2 pi j / nk, so the Fermi surface |kx| + |ky| = pi
    contains grid points; they get the occupation 1/2.  That keeps the
    particle-hole symmetry n(k + Q) = 1 - n(k), Q = (pi, pi), exact, and with
    it <c^dag_0 c_r> = 0 for every r != 0 with |rx| + |ry| even.  (The
    midpoint grid of free_fermion.py.in has no point on the Fermi surface and
    leaves ~1e-4 there, which is harmless for the energy but not for a
    reference that is exactly zero.)  e^{ik.r} is replaced by cos(k.r): the
    occupation is even in k.
    """
    k = 2.0 * np.pi * np.arange(nk) / nk
    kx, ky = np.meshgrid(k, k, indexing="ij")
    eps = -2.0 * T * (np.cos(kx) + np.cos(ky))
    # |eps| < 1e-9 only on the Fermi surface; the next grid energies are of
    # order 2 pi / nk.
    occ = np.where(eps < -1.0e-9, 1.0, np.where(eps > 1.0e-9, 0.0, 0.5))
    rx, ry = displacement
    return float(np.mean(np.cos(kx * rx + ky * ry) * occ))


def reference_self_check():
    """Checks of the reference itself, not of TeNeS."""
    failures = []
    n = exact_hopping((0, 0))
    if abs(n - 0.5) > 1.0e-12:
        failures.append(f"reference: density {n} is not 1/2")
    # energy per site = -4 t <c^dag_0 c_x>; the spinless Fermi-sea value is
    # -8 t / pi^2
    energy = -4.0 * T * exact_hopping((1, 0))
    if abs(energy - (-8.0 * T / np.pi**2)) > 1.0e-3:
        failures.append(f"reference: energy {energy} is not -8 t / pi^2")
    for r in [(2, 0), (1, 1), (4, 0), (6, 0), (3, 1)]:
        if abs(exact_hopping(r)) > 1.0e-12:
            failures.append(f"reference: <c^dag_0 c_{r}> is not zero")
    for r in [(2, 1), (3, 0), (5, 0)]:
        coarse, fine = exact_hopping(r, 1024), exact_hopping(r)
        if abs(coarse - fine) > 1.0e-3:
            failures.append(f"reference: {r} not converged in nk ({coarse}, {fine})")
    return failures


# G(1, 0) is the largest |<c^dag_0 c_r>| (r != 0) and does not come out of a
# cancellation; every tolerance below is anchored on it
# (docs/superpowers/specs/2026-09-05-fermion-test-tolerance-contract.md).
G_NN = exact_hopping((1, 0))

# ANALYTIC_REL: the D = 2 simple-update state is far from the Fermi sea,
# and not only by a small amount.  Measured with this input on 2026-09-25
# (Release, g++-16, macOS), the state is a checkerboard charge-density wave:
# the density is 0.68 / 0.32 on the two sublattices, <c^dag_s c_{s+(1,1)}>
# is -0.117 on sublattice A and +0.117 on sublattice B (exact: 0), and
# <c^dag_s c_{s+(2,0)}> is -0.035 / +0.035 (exact: 0).  The same happens at
# D = 3 and D = 4 (0.10-0.13 at (1, 1)), so a larger D does not help.  The
# staggered part cancels in the average over the four sites of the unit
# cell, and what is compared with the Fermi sea is that average (the
# hopping, = 2 <c^dag_0 c_r>, halved).  Its measured worst deviation over
# every compared number is 0.0261 (the correlation function at (0, 3); the
# (3, 0) and (1, 0) ones are 0.0256 and 0.0237, the halved hopping at (3, 0)
# 0.0256), i.e. 0.129 G(1, 0).  D = 3 and D = 4 (tau = 0.01, 1000 steps)
# give 0.022 and 0.032.  The tolerance is 0.25 G(1, 0) = 0.0507, a factor
# 1.9 above the measurement.
#
# What this can and cannot catch: a sign error at (1, 0) or (2, 1) (measured
# -0.0474 against the exact -0.0675; flipped, the error would be 0.115) and
# any error of the size of the nearest-neighbour value.  The (3, 0) and
# longer values are below the tolerance at this D (at (3, 0) the measured
# average is -0.0030 against the exact +0.0225), so their sign is NOT tested
# here; the identities of check 4 and the unit tests of the relay carry
# that.
ANALYTIC_REL = 0.25

# TIGHT_TOL: identities between two numbers computed from the same state and
# the same environment tensors, with the same window, through different
# contractions or different operator constructions; they agree to rounding.
# Measured worst deviation on 2026-09-25 (Release, g++-16, macOS): 3.9e-16
# (window against transfer), 2.8e-16 (explicit hopping against the ops
# sum), 0 ([c, cdag] against -[cdag, c]).  1e-9 G(1, 0) = 2e-10 leaves five
# decades for other compilers and BLAS.  What it has to catch is a wrong
# sign or a dropped channel, which moves a value by the value itself; the
# smallest value compared here is |<c^dag_0 c_(3,0)>| = 3.0e-3.
TIGHT_TOL = 1.0e-9 * G_NN

# ENV_TOL: identities that hold for the exact environment only.  The forward
# and the reversed bond (<c^dag_s c_t> against <c^dag_t c_s>) sit in the same
# window, but the converged CTM environment is Hermitian only to its
# convergence; the nearest-neighbour hopping of tenes_simple and the r = 1
# correlation use different environment tensors.  Measured worst deviation
# on 2026-09-25: 1.2e-9 (reversed bond at distance 3) and 1.8e-10
# (nearest-neighbour paths), with convergence_epsilon = 1e-8.
# 1e-6 G(1, 0) = 2e-7 is 170 times that, and 1.5e4 times smaller than the
# smallest value compared (3.0e-3).
ENV_TOL = 1.0e-6 * G_NN

# MPI_TOL: an N-process run against the one-process run on the same
# input.toml.  Measured on 2026-09-25 (Debug MPI build, Open MPI, macOS):
# every number of density.dat, onesite_obs.dat, twosite_obs.dat and
# correlation.dat agrees to 2e-15.  The two runs can still stop the CTM at a
# different sweep on another platform (convergence_epsilon = 1e-8), which
# moves the observables by about that much; 5e-6 G(1, 0) = 1e-6 stays above
# that, and far below what an MPI reduction bug does (a partial sum over one
# rank's blocks is off by a fraction of the value itself).
MPI_TOL = 5.0e-6 * G_NN


# ---------------------------------------------------------------------------
# Running
# ---------------------------------------------------------------------------


def parse_args(argv):
    nproc = 1
    args = list(argv)
    if "--nproc" in args:
        nproc = int(args[args.index("--nproc") + 1])
    return nproc


def launcher(nproc):
    cmd = []
    if MPIEXEC:
        cmd.append(MPIEXEC)
        cmd.extend("@MPIEXEC_PREFLAGS@".split())
        cmd.append("@MPIEXEC_NUMPROC_FLAG@")
        cmd.append(str(nproc))
        cmd.extend("@MPIEXEC_POSTFLAGS@".split())
    elif nproc != 1:
        raise RuntimeError("this build has no MPI launcher; --nproc must be 1")
    return cmd


def run(cmd, cwd):
    print("run:", " ".join(cmd), flush=True)
    proc = subprocess.run(cmd, cwd=cwd, check=False, text=True, capture_output=True)
    return proc


def run_tool(cmd, cwd, label):
    proc = run(cmd, cwd)
    if proc.returncode != 0:
        print(proc.stdout + proc.stderr)
        print(f"{label} failed: {os.path.basename(cmd[0])} exited with {proc.returncode}")
        return False
    return True


def site_index(x, y):
    return (x % L_SUB[0]) + L_SUB[0] * (y % L_SUB[1])


def target_site(source, dx, dy):
    x, y = source % L_SUB[0], source // L_SUB[0]
    return site_index(x + dx, y + dy)


def bonds_text(displacements):
    return "\n".join(
        f"{source} {dx} {dy}" for source in range(NSITES) for dx, dy in displacements
    )


def unique(seq):
    out = []
    for item in seq:
        if item not in out:
            out.append(item)
    return out


HOPPING_DISPLACEMENTS = unique(NEAREST + CONTRACT_DISPLACEMENTS)
OPS_DISPLACEMENTS = unique(
    STRAIGHT
    + CONTRACT_DISPLACEMENTS
    + [(-dx, -dy) for dx, dy in unique(STRAIGHT + CONTRACT_DISPLACEMENTS)]
)


def extend_std_toml(path):
    """Add the long-range two-site observables to the std.toml of
    tenes_simple.  Returns the group numbers of the added observables and the
    one-site operator table of the std.toml."""
    std = toml.load(path)
    onesite = [(o["name"], o["group"]) for o in std["observable"]["onesite"]]
    groups = dict(onesite)
    twosite = std["observable"]["twosite"]
    hopping = [entry for entry in twosite if entry["name"] == "hopping"]
    if len(hopping) != 1:
        raise RuntimeError("tenes_simple did not emit exactly one 'hopping'")
    next_group = max(entry["group"] for entry in twosite) + 1
    added = {}
    twosite.append(
        {
            "name": "hopping_longrange",
            "group": next_group,
            "dim": [2, 2],
            "bonds": bonds_text(HOPPING_DISPLACEMENTS),
            "elements": hopping[0]["elements"],
        }
    )
    added["hopping_longrange"] = next_group
    for name, ops in (("cdag_c", ["cdag", "c"]), ("c_cdag", ["c", "cdag"])):
        next_group += 1
        twosite.append(
            {
                "name": name,
                "group": next_group,
                "dim": [2, 2],
                "bonds": bonds_text(OPS_DISPLACEMENTS),
                "ops": [groups.get(ops[0], -1), groups.get(ops[1], -1)],
            }
        )
        added[name] = next_group
    added["hopping"] = hopping[0]["group"]
    with open(path, "w") as f:
        toml.dump(std, f)
    return added, onesite


# ---------------------------------------------------------------------------
# Reading the output
# ---------------------------------------------------------------------------


def read_rows(path):
    rows = []
    with open(path) as f:
        for line in f:
            line = line.split("#", 1)[0].strip()
            if line:
                rows.append([float(word) for word in line.split()])
    return rows


def read_density(path):
    values = []
    with open(path) as f:
        for line in f:
            if "=" not in line:
                continue
            name, raw = line.split("=", 1)
            words = raw.split()
            values.append((name.strip(), complex(float(words[0]), float(words[1]))))
    return values


def twosite_table(outdir):
    """{(group, source, dx, dy): complex}"""
    table = {}
    for row in read_rows(join(outdir, "twosite_obs.dat")):
        group, source, dx, dy, re, im = row
        table[(int(group), int(source), int(dx), int(dy))] = complex(re, im)
    return table


def correlation_table(outdir):
    """{(left_op, left_site, right_op, dx, dy): complex}"""
    table = {}
    for row in read_rows(join(outdir, "correlation.dat")):
        lop, lsite, rop, dx, dy, re, im = row
        table[(int(lop), int(lsite), int(rop), int(dx), int(dy))] = complex(re, im)
    return table


# ---------------------------------------------------------------------------
# Checks
# ---------------------------------------------------------------------------


def check_schema(onesite, input_param):
    failures = []
    if onesite[:3] != [("n", 0), ("cdag", 1), ("c", 2)]:
        failures.append(
            "std.toml: the one-site operators of the spinless fermion must be "
            f"0: n, 1: cdag, 2: c; got {onesite}"
        )
    if input_param["parameter"]["general"].get("fermion") is not True:
        failures.append("input.toml: parameter.general.fermion is not true")
    correlation = input_param.get("correlation")
    if correlation is None:
        failures.append("input.toml has no [correlation] section")
    else:
        if correlation.get("r_max") != R_MAX:
            failures.append(f"input.toml: r_max = {correlation.get('r_max')}")
        if correlation.get("operators") != [[0, 0], [1, 2]]:
            failures.append(
                "input.toml: the default [correlation] operators of the "
                "spinless fermion must be [[0, 0], [1, 2]]; got "
                f"{correlation.get('operators')}"
            )
    return failures


def check_warnings(label, output):
    failures = []
    for pattern in ("CTM did not converge", "Norm is negative", "Norm is not real"):
        hits = [line.strip() for line in output.splitlines() if pattern in line]
        if hits:
            failures.append(f"{label}: tenes printed {hits[0]!r}")
    return failures


def check_odd_onesite_is_zero(outdir):
    failures = []
    density = dict(read_density(join(outdir, "density.dat")))
    for name in ("cdag", "c"):
        if name not in density:
            failures.append(f"density.dat has no {name} row")
        elif density[name] != 0.0:
            failures.append(f"density.dat: {name} = {density[name]}, must be exactly 0")
    rows = read_rows(join(outdir, "onesite_obs.dat"))
    seen = set()
    for group, site, re, im in rows:
        if int(group) in (1, 2):
            seen.add((int(group), int(site)))
            if re != 0.0 or im != 0.0:
                failures.append(
                    f"onesite_obs.dat: group {int(group)} site {int(site)} is "
                    f"{re} + {im}i; an odd one-site operator must give exactly 0"
                )
    if len(seen) != 2 * NSITES:
        failures.append(f"onesite_obs.dat: cdag / c rows for {sorted(seen)} only")
    return failures


WORST = {}


def note(kind, err, what):
    if err > WORST.get(kind, (-1.0, ""))[0]:
        WORST[kind] = (err, what)


def close(kind, value, reference, tol, what, failures):
    err = abs(value - reference)
    note(kind, err, what)
    if not err <= tol:
        failures.append(
            f"{what}: {value} against {reference} (|diff| {err:.3e} > {tol:.3e})"
        )


def lookup(table, key, what, failures):
    if key not in table:
        failures.append(f"{what}: {key} is missing from the output")
        return None
    return table[key]


def check_identities(outdir, groups):
    """Check 4: per site; TIGHT_TOL or ENV_TOL, see there."""
    failures = []
    two = twosite_table(outdir)
    cor = correlation_table(outdir)
    g_hop = groups["hopping"]
    g_long = groups["hopping_longrange"]
    g_cc = groups["cdag_c"]
    g_ccd = groups["c_cdag"]

    for key, value in list(two.items()) + list(cor.items()):
        close("imag", value.imag, 0.0, TIGHT_TOL, f"imaginary part of {key}", failures)

    for source in range(NSITES):
        for dx, dy in OPS_DISPLACEMENTS:
            t = target_site(source, dx, dy)
            fwd = lookup(two, (g_cc, source, dx, dy), "cdag_c", failures)
            back = lookup(two, (g_cc, t, -dx, -dy), "cdag_c", failures)
            rev = lookup(two, (g_ccd, source, dx, dy), "c_cdag", failures)
            if None in (fwd, back, rev):
                continue
            # <c^dag_s c_t> is real (real tensors) and equals its conjugate
            # <c^dag_t c_s>, measured on the reversed bond from site t.
            close(
                "reverse",
                fwd.real,
                back.real,
                ENV_TOL,
                f"<cdag_{source} c_(+{dx},{dy})> vs the reversed bond",
                failures,
            )
            # <c_s c^dag_t> = -<c^dag_t c_s>
            close(
                "c_cdag",
                rev.real,
                -back.real,
                TIGHT_TOL,
                f"<c_{source} cdag_(+{dx},{dy})> vs -<cdag c> of the reversed bond",
                failures,
            )
        for dx, dy in HOPPING_DISPLACEMENTS:
            t = target_site(source, dx, dy)
            hop = lookup(two, (g_long, source, dx, dy), "hopping_longrange", failures)
            fwd = lookup(two, (g_cc, source, dx, dy), "cdag_c", failures)
            back = lookup(two, (g_cc, t, -dx, -dy), "cdag_c", failures)
            if None in (hop, fwd, back):
                continue
            # explicit c^dag_s c_t + c^dag_t c_s against the two ops products
            close(
                "hopping_vs_ops",
                hop.real,
                fwd.real + back.real,
                TIGHT_TOL,
                f"hopping_longrange at {source} ({dx},{dy}) vs cdag_c sum",
                failures,
            )
        for dx, dy in NEAREST:
            old = lookup(two, (g_hop, source, dx, dy), "hopping", failures)
            new = lookup(two, (g_long, source, dx, dy), "hopping_longrange", failures)
            if None not in (old, new):
                close(
                    "nn_paths",
                    new.real,
                    old.real,
                    ENV_TOL,
                    f"hopping_longrange vs hopping at {source} ({dx},{dy})",
                    failures,
                )
        for dx, dy in STRAIGHT:
            r = max(abs(dx), abs(dy))
            c = lookup(cor, (1, source, 2, dx, dy), "correlation (cdag, c)", failures)
            w = lookup(two, (g_cc, source, dx, dy), "cdag_c", failures)
            if None not in (c, w):
                close(
                    "window_vs_transfer",
                    c.real,
                    w.real,
                    TIGHT_TOL,
                    f"correlation (cdag, c) at {source} r={r} ({dx},{dy}) vs cdag_c",
                    failures,
                )
            if r == 1:
                old = lookup(two, (g_hop, source, dx, dy), "hopping", failures)
                if None not in (c, old):
                    # the r = 1 correlation against the nearest-neighbour
                    # hopping of tenes_simple (the pre-existing path)
                    close(
                        "nn_paths",
                        2.0 * c.real,
                        old.real,
                        ENV_TOL,
                        f"2 x correlation (cdag, c) at {source} ({dx},{dy}) "
                        "vs hopping",
                        failures,
                    )
    return failures


def site_average(table, key_of_source, what, failures):
    values = []
    for source in range(NSITES):
        v = lookup(table, key_of_source(source), what, failures)
        if v is None:
            return None
        values.append(v.real)
    return float(np.mean(values))


def check_analytic(outdir, groups):
    """Check 5: site averages against the Fermi sea."""
    failures = []
    two = twosite_table(outdir)
    cor = correlation_table(outdir)
    tol = ANALYTIC_REL * G_NN
    for dx, dy in CONTRACT_DISPLACEMENTS:
        exact = exact_hopping((dx, dy))
        hop = site_average(
            two, lambda s: (groups["hopping_longrange"], s, dx, dy), "hopping", failures
        )
        if hop is not None:
            close(
                "analytic",
                hop / 2.0,
                exact,
                tol,
                f"site-averaged hopping / 2 at ({dx},{dy})",
                failures,
            )
        cc = site_average(two, lambda s: (groups["cdag_c"], s, dx, dy), "cdag_c", failures)
        if cc is not None:
            close("analytic", cc, exact, tol, f"site-averaged cdag_c at ({dx},{dy})", failures)
    for r in range(1, R_MAX + 1):
        for dx, dy in ((r, 0), (0, r)):
            exact = exact_hopping((dx, dy))
            c = site_average(
                cor, lambda s: (1, s, 2, dx, dy), "correlation (cdag, c)", failures
            )
            if c is not None:
                close(
                    "analytic",
                    c,
                    exact,
                    tol,
                    f"site-averaged correlation (cdag, c) at ({dx},{dy})",
                    failures,
                )
    return failures


def compare_files(filename, result_dir, reference_dir, rtol, atol, label):
    failures = []
    path_res = join(result_dir, filename)
    path_ref = join(reference_dir, filename)
    if not os.path.exists(path_ref):
        return [f"{label}: reference file is missing: {path_ref}"]
    if filename == "density.dat":
        res = [v for _, v in read_density(path_res)]
        ref = [v for _, v in read_density(path_ref)]
        res = [[v.real, v.imag] for v in res]
        ref = [[v.real, v.imag] for v in ref]
    else:
        res = read_rows(path_res)
        ref = read_rows(path_ref)
    if len(res) != len(ref):
        return [f"{label}: {filename} has {len(res)} rows, the reference {len(ref)}"]
    for index, (rrow, frow) in enumerate(zip(res, ref)):
        if len(rrow) != len(frow) or not np.all(
            np.isclose(rrow, frow, rtol=rtol, atol=atol)
        ):
            failures.append(
                f"{label}: {filename} row {index} differs: {rrow} vs reference {frow}"
            )
    return failures


def compare_runs(result_dir, reference_dir, tol, label):
    failures = []
    for filename in GOLDEN_FILES:
        failures += compare_files(filename, result_dir, reference_dir, 0.0, tol, label)
    return failures


# ---------------------------------------------------------------------------


def main():
    nproc = parse_args(sys.argv[1:])
    label = NAME if nproc == 1 else f"{NAME}MPI{nproc}"
    update_golden = nproc == 1 and os.environ.get(UPDATE_GOLDEN_ENV) == "1"

    failures = reference_self_check()
    if failures:
        for message in failures:
            print(label + " reference self-check failed: " + message)
        return 1

    work_dir = join("@CMAKE_CURRENT_BINARY_DIR@", "output_" + label)
    if os.path.isdir(work_dir):
        shutil.rmtree(work_dir)
    os.makedirs(work_dir)
    with open(join(work_dir, "simple.toml"), "w") as f:
        f.write(SIMPLE_TOML)

    if not run_tool([TENES_SIMPLE, "simple.toml", "-o", "std.toml"], work_dir, label):
        return 1
    groups, onesite = extend_std_toml(join(work_dir, "std.toml"))
    if not run_tool([TENES_STD, "std.toml", "-o", "input.toml"], work_dir, label):
        return 1

    input_param = toml.load(join(work_dir, "input.toml"))
    failures += check_schema(onesite, input_param)

    runs = [nproc] if nproc == 1 else [nproc, 1]
    outdirs = {}
    for n in runs:
        run_dir = join(work_dir, f"np{n}")
        os.makedirs(run_dir)
        shutil.copyfile(join(work_dir, "input.toml"), join(run_dir, "input.toml"))
        proc = run(launcher(n) + [TENES, "input.toml"], run_dir)
        output = proc.stdout + proc.stderr
        with open(join(run_dir, "tenes.log"), "w") as f:
            f.write(output)
        if proc.returncode != 0:
            print(output)
            print(f"{label} failed: tenes on {n} process(es) exited with {proc.returncode}")
            return 1
        failures += check_warnings(f"{label} np{n}", output)
        outdirs[n] = join(run_dir, "output")

    outdir = outdirs[nproc]
    failures += check_odd_onesite_is_zero(outdir)
    failures += check_identities(outdir, groups)
    failures += check_analytic(outdir, groups)
    if nproc != 1:
        failures += compare_runs(outdir, outdirs[1], MPI_TOL, f"np{nproc} vs np1")

    for kind, (err, what) in sorted(WORST.items()):
        print(f"{label} worst |diff| [{kind}] {err:.3e} on {what}")

    if failures:
        for message in failures:
            print(label + " failed: " + message)
        return 1

    if update_golden:
        os.makedirs(GOLDEN_DIR, exist_ok=True)
        for filename in GOLDEN_FILES:
            shutil.copyfile(join(outdir, filename), join(GOLDEN_DIR, filename))
        print(f"{label}: golden files written to {GOLDEN_DIR}")
        return 0

    for n, directory in sorted(outdirs.items()):
        for filename in GOLDEN_FILES:
            failures += compare_files(
                filename, directory, GOLDEN_DIR, RTOL, ATOL, f"np{n} vs golden"
            )
    if failures:
        for message in failures:
            print(label + " failed: " + message)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
