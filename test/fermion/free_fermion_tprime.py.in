# Items 2 and 3 of the T3 contract of
# docs/superpowers/plans/2026-09-30-fermion-longrange-hamiltonian.md
# (design: docs/superpowers/specs/2026-09-30-fermion-longrange-hamiltonian-design.md):
# free spinless fermions with a next-nearest-neighbour hopping t' on the
# square lattice, through the standard pipeline
#
#   simple.toml -> tenes_simple -> std.toml -> tenes_std -> input.toml -> tenes
#
# The t' bonds (1, 1) and (-1, 1) are two hops apart on the square grid, so
# tenes_std turns their imaginary-time gate into a chain of two
# nearest-neighbour gates (the graded MPO of design section 4.1), and the
# simple update carries the fattened physical leg of the middle site from
# one gate to the next (design section 6).  This test is what says whether
# the chain applies the right operator: the state it produces is compared
# with the exact Fermi sea.
#
# The sign convention of t' (read from tool/tenes_simple.py on 2026-09-30):
# SpinlessFermionModel.model_bondhamiltonian writes every bond as
#
#   H_bond = -t_n (c^dag_s c_t + c^dag_t c_s) + V_n n_s n_t - (mu / z)(n_s + n_t),
#
# where t_n is "t" for the first neighbour level and "t'" for the second,
# and SquareLattice puts the second level on the displacements (1, 1) and
# (-1, 1) of every site (bond types 0 and 1); z is the total number of bond
# ends per site over all emitted levels, so the chemical potential adds up
# to -mu n per site.  In momentum space (k conjugate to the lattice index)
#
#   eps(k) = -2 t (cos kx + cos ky) - 2 t' (cos(kx + ky) + cos(kx - ky))
#          = -2 t (cos kx + cos ky) - 4 t' cos kx cos ky,
#
# and the energy per site that TeNeS reports (sum of the bond Hamiltonians
# over the bonds of the unit cell, divided by the number of sites) is the
# grand-canonical one, int d^2k / (2 pi)^2 (eps(k) - mu) theta(mu - eps(k)).
# The reference below is that momentum integral; nothing of TeNeS enters it.
#
# Why these parameters:
#
# * mu = -1, not 0: at mu = 0 the particle-hole transformation c -> (-1)^r
#   c^dag maps t' to -t' and leaves the grand-canonical energy unchanged, so
#   a wrong sign of t' would not show.  At mu = -1 the exact values are
#       t' = +0.3:  E = -0.53007, n = 0.2837, <c^dag_0 c_(1,1) + h.c.> = 0.1915
#       t' = -0.3:  E = -0.34271, n = 0.4275, <c^dag_0 c_(1,1) + h.c.> = 0.0086
# * One run, at t' = -0.3.  The first version (2026-09-30) also ran
#   t' = +0.3 and compared E(+0.3) - E(-0.3) with the exact -0.187, as the
#   T3 contract (item 3) asked; it took 129 s and was cut to fit a 30 s
#   budget (2026-10-01).  The t' = -0.3 run carries both jobs: a reversed
#   sign of the t' term makes it the t' = +0.3 model (diagonal hopping 0.19
#   instead of 0.009, density 0.28 instead of 0.43), and a chain without the
#   parity string (see DIAG_TOL) moves the same two numbers.  The t' = +0.3
#   checks never caught the string-less chain (measured 2026-09-30: they
#   all passed with it).
# * D = 3: D = 2 falls into the vacuum from a random start once t' != 0
#   (LEDGER 2026-09-30).  tau = 0.1 x 200 steps, chi = 9, iteration_max =
#   30, seed 11: 22 s for tenes at OMP_NUM_THREADS=1 in a Debug build
#   (2026-10-01).  The first version had tau = 0.05 x 400, chi = 18,
#   iteration_max = 100.
# * iteration_max: see CTM_ITERATION_MAX below.
#
# What is checked:
#
#   1. the schema: tenes_simple emitted the (1, 1) and (-1, 1) bonds of every
#      site in the Hamiltonian (contract item 1), and input.toml is in
#      fermion mode;
#   2. no norm warning; the one-site values of cdag and c are exactly 0;
#   3. the energy balance E = -t <hop_NN> - t' <hop_diag> - mu n per site,
#      between numbers of one run (ENV_TOL): the energy is the measured bond
#      Hamiltonian, the other three are separate observables;
#   4. the exact values (see the tolerances below): the diagonal hopping
#      averaged over the sites, separately for (1, 1) and (-1, 1)
#      (DIAG_TOL), the density (DENSITY_TOL), and the energy not below the
#      exact ground-state energy (VARIATIONAL_TOL).
#
# There are no golden files: everything is compared with the exact values.
#
# Mutation runs: the environment variables TENES_TEST_TENES_SIMPLE and
# TENES_TEST_TENES_STD, if set, replace the tenes_simple and tenes_std of
# the build tree (each is a command line, split like a shell would split
# it, e.g. "python3 /tmp/tenes_std.py").  They exist so that a modified copy
# of a tool can be run through this test (for example tenes_std without the
# parity string of design section 4.1, which has to make this test fail).

import functools
import os
import shlex
import shutil
import subprocess
import sys
from os.path import join

import numpy as np
import toml

TENES_SIMPLE = join("@CMAKE_BINARY_DIR@", "tool", "tenes_simple")
TENES_STD = join("@CMAKE_BINARY_DIR@", "tool", "tenes_std")
TENES = join("@CMAKE_BINARY_DIR@", "src", "tenes")
MPIEXEC = "@MPIEXEC@"

NAME = "FreeFermionTPrime"
TOOL_OVERRIDES = ("TENES_TEST_TENES_SIMPLE", "TENES_TEST_TENES_STD")

T = 1.0
TPRIME = -0.3
# both signs for the reference self-check only; only TPRIME is run
TPRIMES = (0.3, -0.3)
MU = -1.0
L_SUB = (2, 2)
NSITES = L_SUB[0] * L_SUB[1]
NEAREST = [(1, 0), (0, 1)]
DIAGONAL = [(1, 1), (-1, 1)]

# CTM_ITERATION_MAX: at chi = 9 the CTM converges in fewer than 100 sweeps;
# stopped at 30 it prints "CTM did not converge" (sig_max = 1.9e-7,
# rdm_dist = 2.6e-12), and every observable of density.dat,
# onesite_obs.dat and twosite_obs.dat agrees with the 100-sweep run to
# 2.4e-12 (measured with this test's input.toml, 2026-10-01).  So the
# warning is reported but not a failure.
CTM_ITERATION_MAX = 30

SIMPLE_TOML = """
[parameter.general]
is_real = true
output = "output"

[parameter.simple_update]
tau = 0.1
num_step = 200

[parameter.full_update]
num_step = 0

[parameter.ctm]
dimension = 9
convergence_epsilon = 1.0e-8
iteration_max = {iteration_max}

[parameter.random]
seed = 11

[lattice]
type = "square lattice"
L = 2
W = 2
virtual_dim = 3
initial = "random"

[model]
type = "spinless fermion"
t = {t}
"t'" = {tprime}
mu = {mu}
"""


# ---------------------------------------------------------------------------
# The exact reference
# ---------------------------------------------------------------------------


@functools.lru_cache(maxsize=None)
def exact(tprime, nk=2048):
    """Grand-canonical energy per site, density, and <c^dag_0 c_r + h.c.>
    for r = (1, 0) and r = (1, 1) of the Fermi sea of
    eps(k) = -2 t (cos kx + cos ky) - 4 t' cos kx cos ky at chemical
    potential MU, on the midpoint grid k = 2 pi (j + 1/2) / nk."""
    k = 2.0 * np.pi * (np.arange(nk) + 0.5) / nk
    kx, ky = np.meshgrid(k, k, indexing="ij")
    eps = -2.0 * T * (np.cos(kx) + np.cos(ky)) - 4.0 * tprime * np.cos(kx) * np.cos(ky)
    occ = (eps - MU < 0.0).astype(float)
    energy = float(np.mean((eps - MU) * occ))
    density = float(np.mean(occ))
    hop_nn = float(2.0 * np.mean(np.cos(kx) * occ))
    hop_diag = float(2.0 * np.mean(np.cos(kx + ky) * occ))
    return {"energy": energy, "n": density, "hop_nn": hop_nn, "hop_diag": hop_diag}


def reference_self_check():
    """Checks of the reference itself, not of TeNeS."""
    failures = []
    for tprime in TPRIMES:
        ref = exact(tprime)
        # the energy is the sum of its parts: 2 nearest-neighbour and 2
        # diagonal bonds per site (the hopping values are per bond)
        balance = -2.0 * T * ref["hop_nn"] - 2.0 * tprime * ref["hop_diag"]
        balance -= MU * ref["n"]
        if abs(balance - ref["energy"]) > 1.0e-4:
            failures.append(
                f"t' = {tprime}: energy {ref['energy']} is not the sum of its "
                f"parts {balance}"
            )
        coarse = exact.__wrapped__(tprime, 1024)
        for key in ref:
            if abs(coarse[key] - ref[key]) > 1.0e-3:
                failures.append(
                    f"t' = {tprime}: {key} not converged in nk "
                    f"({coarse[key]}, {ref[key]})"
                )
    # the values quoted in the contract (T3 item 3)
    quoted = {
        0.3: {"energy": -0.53007, "n": 0.2837, "hop_diag": 0.1915},
        -0.3: {"energy": -0.34272, "n": 0.4275, "hop_diag": 0.0086},
    }
    for tprime, values in quoted.items():
        for key, value in values.items():
            if abs(exact(tprime)[key] - value) > 2.0e-4:
                failures.append(
                    f"t' = {tprime}: {key} = {exact(tprime)[key]}, the contract "
                    f"quotes {value}"
                )
    return failures


# ---------------------------------------------------------------------------
# Tolerances
# ---------------------------------------------------------------------------

# What the tolerances have to separate (measured 2026-10-01 with this input,
# Debug, OMP_NUM_THREADS=1; seeds other than 11 for robustness only):
#
#                         <hop_diag> (1,1) / (-1,1)    n       E
#   right chain, seed 11  -0.0035 / 0.0086            0.4398  -0.2798
#           seeds 1, 3    -0.004..0.001 / 0.009..0.025 0.432..0.439
#   string removed,       0.146..0.152 / 0.134..0.140  0.296..0.298
#           seeds 11, 1, 3
#   exact                 0.0086                       0.4275  -0.3427
#
# "string removed" is the mutation the plan requires this test to catch
# (T3 step 6: tenes_std without the parity string of design section 4.1,
# `sign = 1` in _make_fermion_path_tensor).  Without the string the chain
# applies c^dag_s (1 - 2 n_m) c_t (m the middle site of the path), a
# weakened t' rather than a reversed one, which pulls both numbers towards
# their t' = 0 values (0.13 and 0.30).  A reversed t' gives 0.19 and 0.28.
#
# Seed 2 is a warning about the seed, not about the tolerances: the right
# chain lands in a poorer, anisotropic state there (E = -0.2314, n =
# 0.316, diagonal 0.063 / 0.078), which the density check would reject
# and the diagonal check would not (the string-less chain gives 0.128 /
# 0.122, n = 0.283 at seed 2).  Seed 11 is not near that state.

# DIAG_TOL: absolute, on the site average of <c^dag_s c_{s+r} + h.c.> for
# r = (1, 1) and for r = (-1, 1) separately, around the exact 0.0086.  The
# right chain is at most 0.017 away, the string-less one 0.125 or more
# (0.045 beyond the tolerance).  The two directions are checked separately
# because the (-1, 1) chain runs to the left (its first gate has source_leg
# 0 in the TOML), the (1, 1) one to the right, and a sign error in one of
# them only would be halved by an average over both.  (The contract's
# 0.08, which it set for t' = +0.3.)
DIAG_TOL = 0.08

# DENSITY_TOL: absolute, around the exact 0.4275.  The right chain is 0.012
# away (0.005 to 0.012 over seeds 11, 1, 3), the string-less one 0.13 (0.08
# beyond the tolerance).  The contract's 0.05.
DENSITY_TOL = 0.05

# VARIATIONAL_TOL: the energy of the iPEPS, measured with a converged CTM
# environment, is the expectation value of the Hamiltonian in a physical
# state and cannot lie below the exact ground-state energy.  The margin is
# for the finite chi of the environment; measured E - E_exact is +0.063.
VARIATIONAL_TOL = 0.01

# ENV_TOL: absolute, the energy balance of check 3.  The energy and the
# hopping observables come from the two-site reduced density matrices, the
# density from the one-site ones, on the same CTM environment but through
# different contractions, so they agree only to the finite chi of the
# environment: measured 2.1e-4 with this input (2026-10-01; 1.3e-5 and
# 3.3e-5 at chi = 18 in the first version), 5 times below the tolerance.
# The balance does not see a wrong gate (both sides are measured on the
# state the gates produced); it
# sees a Hamiltonian written or measured with another operator than the
# observables, e.g. a far bond whose emitted Hamiltonian lost its hopping
# or its sign, which moves the balance by 2 |t'| <hop_diag> or by the
# nearest-neighbour hopping, 0.005 to 0.2 here.
ENV_TOL = 1.0e-3


# ---------------------------------------------------------------------------
# Running
# ---------------------------------------------------------------------------


def tool_command(env_name, default):
    """The command for a tool: the build tree's, or the one the environment
    variable env_name (TENES_TEST_TENES_SIMPLE / TENES_TEST_TENES_STD) sets,
    announced with a note so that the log shows what was run."""
    override = os.environ.get(env_name)
    if override:
        tool = "tenes_simple" if env_name == "TENES_TEST_TENES_SIMPLE" else "tenes_std"
        print(f"note: using {override} for {tool} ({env_name})", flush=True)
        return shlex.split(override)
    return [default]


def with_override_note(message):
    """A failure message, with the tool overrides in effect appended, so that
    a failure of a mutation run cannot be read as one of the real tools."""
    replaced = [
        f"{name}={os.environ[name]!r}"
        for name in TOOL_OVERRIDES
        if os.environ.get(name)
    ]
    if not replaced:
        return message
    return message + " [tool overrides in effect: " + ", ".join(replaced) + "]"


def launcher():
    cmd = []
    if MPIEXEC:
        cmd.append(MPIEXEC)
        cmd.extend("@MPIEXEC_PREFLAGS@".split())
        cmd.append("@MPIEXEC_NUMPROC_FLAG@")
        cmd.append("1")
        cmd.extend("@MPIEXEC_POSTFLAGS@".split())
    return cmd


def run(cmd, cwd):
    print("run:", " ".join(cmd), flush=True)
    return subprocess.run(cmd, cwd=cwd, check=False, text=True, capture_output=True)


def run_tool(cmd, cwd, label):
    proc = run(cmd, cwd)
    if proc.returncode != 0:
        print(proc.stdout + proc.stderr)
        message = f"{label} failed: {' '.join(cmd)} exited with {proc.returncode}"
        print(with_override_note(message))
        return False
    return True


def bonds_text(displacements):
    return "\n".join(
        f"{source} {dx} {dy}" for source in range(NSITES) for dx, dy in displacements
    )


def parse_bonds(text):
    bonds = set()
    for line in text.splitlines():
        words = line.split()
        if len(words) == 3:
            bonds.add(tuple(int(word) for word in words))
    return bonds


def extend_std_toml(path):
    """Add the diagonal hopping observable "hopping_diag" (tenes_simple's own
    "hopping" elements, c^dag_s c_t + c^dag_t c_s in the source-first basis
    of design section 3) on the (1, 1) and (-1, 1) bonds of every site.
    tenes_simple only emits the nearest-neighbour hopping.  Returns
    {name: group} of the two hopping observables."""
    std = toml.load(path)
    twosite = std["observable"]["twosite"]
    hopping = [entry for entry in twosite if entry["name"] == "hopping"]
    if len(hopping) != 1:
        raise RuntimeError("tenes_simple did not emit exactly one 'hopping'")
    group = max(entry["group"] for entry in twosite) + 1
    twosite.append(
        {
            "name": "hopping_diag",
            "group": group,
            "dim": [2, 2],
            "bonds": bonds_text(DIAGONAL),
            "elements": hopping[0]["elements"],
        }
    )
    with open(path, "w") as f:
        toml.dump(std, f)
    return {"hopping": hopping[0]["group"], "hopping_diag": group}, std


# ---------------------------------------------------------------------------
# Reading the output
# ---------------------------------------------------------------------------


def read_rows(path):
    rows = []
    with open(path) as f:
        for line in f:
            line = line.split("#", 1)[0].strip()
            if line:
                rows.append([float(word) for word in line.split()])
    return rows


def read_density(path):
    values = {}
    with open(path) as f:
        for line in f:
            if "=" not in line:
                continue
            name, raw = line.split("=", 1)
            words = raw.split()
            values[name.strip()] = complex(float(words[0]), float(words[1]))
    return values


def twosite_table(outdir):
    """{(group, source, dx, dy): complex}"""
    table = {}
    for row in read_rows(join(outdir, "twosite_obs.dat")):
        group, source, dx, dy, re, im = row
        table[(int(group), int(source), int(dx), int(dy))] = complex(re, im)
    return table


# ---------------------------------------------------------------------------
# Checks
# ---------------------------------------------------------------------------


def check_schema(label, std, input_param):
    failures = []
    expected = {(s, dx, dy) for s in range(NSITES) for dx, dy in NEAREST + DIAGONAL}
    emitted = set()
    for ham in std.get("hamiltonian", []):
        emitted |= parse_bonds(ham["bonds"])
    if emitted != expected:
        failures.append(
            f"{label}: std.toml Hamiltonian bonds are {sorted(emitted)}; expected "
            f"the nearest-neighbour and the (1, 1), (-1, 1) bonds of every site"
        )
    if input_param["parameter"]["general"].get("fermion") is not True:
        failures.append(f"{label}: input.toml: parameter.general.fermion is not true")
    return failures


def check_warnings(label, output):
    failures = []
    for pattern in ("Norm is negative", "Norm is not real"):
        hits = [line.strip() for line in output.splitlines() if pattern in line]
        if hits:
            failures.append(f"{label}: tenes printed {hits[0]!r}")
    for line in output.splitlines():
        if "CTM did not converge" in line:
            print(f"{label}: note: {line.strip()}")
    return failures


def check_odd_onesite_is_zero(label, outdir):
    failures = []
    density = read_density(join(outdir, "density.dat"))
    for name in ("cdag", "c"):
        if name not in density:
            failures.append(f"{label}: density.dat has no {name} row")
        elif density[name] != 0.0:
            failures.append(f"{label}: density.dat: {name} = {density[name]}")
    for group, site, re, im in read_rows(join(outdir, "onesite_obs.dat")):
        if int(group) in (1, 2) and (re != 0.0 or im != 0.0):
            failures.append(
                f"{label}: onesite_obs.dat: group {int(group)} site {int(site)} "
                f"is {re} + {im}i; an odd one-site operator must give exactly 0"
            )
    return failures


def direction_average(table, group, displacement, label, failures):
    values = []
    for source in range(NSITES):
        key = (group, source, displacement[0], displacement[1])
        if key not in table:
            failures.append(f"{label}: twosite_obs.dat has no row {key}")
            return None
        values.append(table[key].real)
    print(f"{label}: hopping at {displacement} per site: {values}")
    return float(np.mean(values))


def within(label, what, value, reference, tol, failures):
    diff = value - reference
    print(
        f"{label}: {what} = {value:.6f} (reference {reference:.6f}, "
        f"diff {diff:+.3e})"
    )
    if not abs(diff) <= tol:
        failures.append(
            f"{label}: {what} = {value} against {reference} "
            f"(|diff| {abs(diff):.3e} > {tol:.3e})"
        )


def check_run(label, tprime, outdir, groups):
    failures = []
    ref = exact(tprime)
    density = read_density(join(outdir, "density.dat"))
    for name in ("Energy", "n", "hopping", "hopping_diag"):
        if name not in density:
            failures.append(f"{label}: density.dat has no {name} row")
    if failures:
        return failures, None
    energy = density["Energy"].real
    n = density["n"].real

    # 3: the energy balance, per site (density.dat sums the bonds of each
    # observable and divides by the number of sites)
    balance = -T * density["hopping"].real - tprime * density["hopping_diag"].real
    balance -= MU * n
    within(label, "energy against its parts", energy, balance, ENV_TOL, failures)

    # 4: the exact values
    table = twosite_table(outdir)
    for displacement in DIAGONAL:
        value = direction_average(
            table, groups["hopping_diag"], displacement, label, failures
        )
        if value is not None:
            within(
                label,
                f"diagonal hopping at {displacement}",
                value,
                ref["hop_diag"],
                DIAG_TOL,
                failures,
            )
    within(label, "density", n, ref["n"], DENSITY_TOL, failures)
    print(f"{label}: energy {energy:.6f}, exact {ref['energy']:.6f}")
    if energy < ref["energy"] - VARIATIONAL_TOL:
        failures.append(
            f"{label}: energy {energy} is below the exact ground-state energy "
            f"{ref['energy']} by more than {VARIATIONAL_TOL}"
        )
    return failures, energy


# ---------------------------------------------------------------------------


def run_one(tprime, work_root):
    label = f"{NAME}(t'={tprime:+.1f})"
    work_dir = join(work_root, f"tp{tprime:+.1f}")
    os.makedirs(work_dir)
    with open(join(work_dir, "simple.toml"), "w") as f:
        f.write(
            SIMPLE_TOML.format(
                iteration_max=CTM_ITERATION_MAX, t=T, tprime=tprime, mu=MU
            )
        )
    simple = tool_command("TENES_TEST_TENES_SIMPLE", TENES_SIMPLE)
    std = tool_command("TENES_TEST_TENES_STD", TENES_STD)
    if not run_tool(simple + ["simple.toml", "-o", "std.toml"], work_dir, label):
        return [f"{label}: tenes_simple failed"], None
    groups, std_param = extend_std_toml(join(work_dir, "std.toml"))
    if not run_tool(std + ["std.toml", "-o", "input.toml"], work_dir, label):
        return [f"{label}: tenes_std failed"], None
    failures = check_schema(label, std_param, toml.load(join(work_dir, "input.toml")))

    proc = run(launcher() + [TENES, "input.toml"], work_dir)
    output = proc.stdout + proc.stderr
    with open(join(work_dir, "tenes.log"), "w") as f:
        f.write(output)
    if proc.returncode != 0:
        print(output)
        return failures + [f"{label}: tenes exited with {proc.returncode}"], None
    outdir = join(work_dir, "output")
    failures += check_warnings(label, output)
    failures += check_odd_onesite_is_zero(label, outdir)
    more, energy = check_run(label, tprime, outdir, groups)
    return failures + more, energy


def main():
    failures = reference_self_check()
    if failures:
        for message in failures:
            print(NAME + " reference self-check failed: " + message)
        return 1

    work_root = join("@CMAKE_CURRENT_BINARY_DIR@", "output_" + NAME)
    if os.path.isdir(work_root):
        shutil.rmtree(work_root)
    os.makedirs(work_root)

    more, _ = run_one(TPRIME, work_root)
    failures += more

    if failures:
        for message in failures:
            print(with_override_note(NAME + " failed: " + message))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
