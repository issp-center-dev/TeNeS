# Items 1 and 4 of the T5 contract of
# docs/superpowers/plans/2026-09-30-fermion-longrange-hamiltonian.md
# (design: docs/superpowers/specs/2026-09-30-fermion-longrange-hamiltonian-design.md,
# section 7): the Hubbard model on the honeycomb lattice with a
# next-nearest-neighbour hopping t', through the standard pipeline
#
#   simple.toml -> tenes_simple -> std.toml -> tenes_std -> input.toml -> tenes
#
# The embedding (read from tool/tenes_simple.py, HoneycombLattice, on
# 2026-09-30) is the brick wall of free_fermion_honeycomb.py.in: the grid
# site (x, y) sits at floor(X / 2) a0 + y a1 + (X mod 2)(a0 + a1) / 3,
# X = x - y, a0 = (sqrt 3, 0), a1 = (sqrt 3 / 2, 3 / 2).  The nearest
# neighbours are the grid displacements (1, 0) of every site and (0, 1) of
# the B sites (x - y odd); the second neighbours (-1, 1), (1, 1), (2, 0) of
# every site are two hops apart, so tenes_std turns their gates into chains
# of two nearest-neighbour gates with d = 4 physical legs (chi up to 64 on
# the middle site; design section 10).  lattice L = 1, W = 2 gives the grid
# cell L_sub = [2, 2]: sites 0 and 3 on A, 1 and 2 on B.
#
# The bond Hamiltonian is that of HubbardModel,
#
#   H_bond = -t_n sum_sigma (c^dag_{s sigma} c_{t sigma} + h.c.)
#            + (U / z)(D_s + D_t) - (mu / z)(n_s + n_t),   z = 3 + 6,
#
# with D the double occupancy and t_n = t (first neighbours) or t' (second),
# so per site
#
#   E = -t <hopping> - t' <hopping_nnn> + U <doublon> - mu <n>,
#
# where <hopping> is the sum of tenes_simple's "hopping" observable over the
# nearest-neighbour bonds of a site, and <hopping_nnn> that of the same
# operator over the second-neighbour bonds (an observable this script adds
# to std.toml; tenes_simple only emits the nearest-neighbour one).
#
# There is no exact solution; the numbers are pinned by golden files, and
# on top of them by what must hold for any state the pipeline can produce
# with the right signs (contract item 4):
#
#   1. the schema: the Hamiltonian bonds of std.toml are the honeycomb first
#      and second neighbours (by their Cartesian length), each pair once,
#      every site with 3 and 6 of them; each bond matrix is -t_n times
#      tenes_simple's "hopping" plus the diagonal (U / z)(D_s + D_t) -
#      (mu / z)(n_s + n_t) built from its "doublon" and "n"; input.toml is in
#      fermion mode with parity [0, 1, 1, 0] on every unit cell;
#   2. no warning (the CTM of this D = 2 state converges, see
#      check_warnings); the odd one-site operators (cdag_up, c_up, cdag_dn,
#      c_dn) are exactly 0;
#   3. the energy balance above, between numbers of one run (ENV_TOL);
#   4. the hopping <sum_sigma c^dag_{s sigma} c_{t sigma} + h.c.> is
#      positive on every nearest-neighbour bond, and its average over the
#      bonds of each of the three bond directions (A (1, 0), B (1, 0),
#      B (0, 1)) is at least MIN_HOPPING.  The contract forbids using the
#      equality of the directions: the simple-update state breaks the
#      lattice symmetry;
#   5. the golden files, with the rtol / atol of test/fulltest.py.in; they
#      include the second-neighbour hopping per bond, which is what the
#      chains of gates act on.
#
# Why these parameters: D = 2, chi = 8 (as HubbardTriangular), t' = -0.3 (as
# FreeFermionHoneycomb), U = 4, mu = U / 2, tau = 0.1 x 80 steps, random
# start with seed 11.  Measured by the test author on 2026-10-01 (Debug,
# OMP_NUM_THREADS=1): 24 s for the whole test, 18 s of it in the simple
# update (0.22 s per step: the second-neighbour chains carry chi up to 64 on
# the middle site) and 4 s in reading the input.  The state is a Neel state
# (Sz = +-0.36 - 0.37 on the A and B sites, 1.3e-4 on average) with
# E = -2.38307, n = 1.0139, doublon 0.0838, nearest-neighbour hopping
# 0.429 - 0.489 per bond (direction averages 0.471 (A (1, 0)), 0.440
# (B (1, 0)), 0.462 (B (0, 1))), and an energy balance of 1.7e-11.
#
# The state is not converged in imaginary time (tau = 0.05 x 400 steps,
# 91 s, gives Sz = +-0.295 and E = -2.38745; tau = 0.1 x 100 steps moves
# the staggered Sz by 1 %), and it need not be: what the golden files
# need is that the same input gives the same numbers on another build.  The
# same input.toml run by the MPI build (ScaLAPACK instead of LAPACK, one
# process) agrees with the Debug build to 4e-12 on every row, eight decades
# below the golden tolerance.  tau = 0.2 x 60 steps (15 s) was not used: its
# Trotter error is large (staggered Sz 0.13, SzSz -0.03 against -0.24).
#
# Mutation (tenes_std without the parity string of design section 4.1,
# measured the same day): it changes only the second-neighbour chains, and
# checks 1-4 do not see it (every nearest-neighbour hopping stays positive,
# 0.38 - 0.55).  The golden files do: 108 rows differ, the energy row
# included (-2.37930 against -2.38307; e.g. SzSz -0.228 against -0.235,
# n 1.0216 against 1.0139).  The free-fermion tests are the ones that
# check the chain against an exact value.
#
# Golden files: test/data/output_HubbardHoneycomb/{density,onesite_obs,
# twosite_obs}.dat in the SOURCE tree.  They do not exist until the
# implementation is in place, and the test fails while they are missing.
# To (re)generate them, on purpose only:
#
#   TENES_UPDATE_HUBBARD_HONEYCOMB_GOLDEN=1 ctest -R '^HubbardHoneycomb$'
#
# in the build tree.  The update mode still runs checks 1-4 and refuses to
# write anything if one of them fails, or if one of the tool overrides
# below is set.
#
# Mutation runs: the environment variables TENES_TEST_TENES_SIMPLE and
# TENES_TEST_TENES_STD, if set, replace the tenes_simple and tenes_std of
# the build tree (each is a command line, split like a shell would split
# it, e.g. "python3 /tmp/tenes_std.py").

import os
import shlex
import shutil
import subprocess
import sys
from os.path import join

import numpy as np
import toml

TENES_SIMPLE = join("@CMAKE_BINARY_DIR@", "tool", "tenes_simple")
TENES_STD = join("@CMAKE_BINARY_DIR@", "tool", "tenes_std")
TENES = join("@CMAKE_BINARY_DIR@", "src", "tenes")

NAME = "HubbardHoneycomb"
GOLDEN_DIR = join("@CMAKE_CURRENT_SOURCE_DIR@", "data", "output_" + NAME)
GOLDEN_FILES = ("density.dat", "onesite_obs.dat", "twosite_obs.dat")
UPDATE_GOLDEN_ENV = "TENES_UPDATE_HUBBARD_HONEYCOMB_GOLDEN"
TOOL_OVERRIDES = ("TENES_TEST_TENES_SIMPLE", "TENES_TEST_TENES_STD")

# test/fulltest.py.in
RTOL = 1.0e-3
ATOL = 1.0e-4

T = 1.0
TPRIME = -0.3
U = 4.0
MU = U / 2
L_SUB = (2, 2)
NSITES = L_SUB[0] * L_SUB[1]
D = 4
# NUM_STEP: see "Why these parameters" above (24 s in total at 80 steps).
NUM_STEP = 80

SIMPLE_TOML = f"""
[parameter.general]
is_real = true
output = "output"

[parameter.simple_update]
tau = 0.1
num_step = {NUM_STEP}

[parameter.full_update]
num_step = 0

[parameter.ctm]
dimension = 8
convergence_epsilon = 1.0e-8
iteration_max = 100

[parameter.random]
seed = 11

[lattice]
type = "honeycomb lattice"
L = 1
W = 2
virtual_dim = 2
initial = "random"

[model]
type = "hubbard"
t = {T}
"t'" = {TPRIME}
U = {U}
mu = {MU}
"""

ODD = ("cdag_up", "c_up", "cdag_dn", "c_dn")

# MIN_HOPPING: the average of the hopping over the bonds of one direction
# has to reach this.  Measured 0.440 - 0.471 (see "Why these parameters");
# a wrong sign on a nearest-neighbour bond makes its hopping negative.
MIN_HOPPING = 0.1
# ENV_TOL: the energy balance of check 3.  The energy and the hopping
# observables come from the two-site reduced density matrices, the density
# and the double occupancy from the one-site ones; the two agree to the
# finite chi and the convergence of the CTM environment (HubbardTriangular
# measured 1.2e-8, this test 1.7e-11).  A Hamiltonian bond written with
# another operator than the observables moves the balance by the size of a
# bond term, 0.1 or more.
ENV_TOL = 1.0e-5


# ---------------------------------------------------------------------------
# The geometry (see free_fermion_honeycomb.py.in)
# ---------------------------------------------------------------------------

SQ3 = np.sqrt(3.0)
A0 = np.array([SQ3, 0.0])
A1 = np.array([SQ3 / 2.0, 1.5])
B_OFFSET = (A0 + A1) / 3.0
LEVELS = {"NN": (1.0, T), "NNN": (SQ3, TPRIME)}
COORDINATION = {"NN": 3, "NNN": 6}
Z = sum(COORDINATION.values())
# the three nearest-neighbour bond directions: (sublattice, dx, dy)
NN_DIRECTIONS = [("A", 1, 0), ("B", 1, 0), ("B", 0, 1)]


def grid_position(x, y):
    q, r = divmod(x - y, 2)
    return q * A0 + y * A1 + r * B_OFFSET


def cell_coord(index):
    return index % L_SUB[0], index // L_SUB[0]


def sublattice(index):
    x, y = cell_coord(index)
    return "A" if (x - y) % 2 == 0 else "B"


def in_cell(x, y):
    ox, xc = divmod(x, L_SUB[0])
    oy, yc = divmod(y, L_SUB[1])
    return xc + L_SUB[0] * yc, (ox, oy)


def bond_length(source, dx, dy):
    x, y = cell_coord(source)
    return float(np.linalg.norm(grid_position(x + dx, y + dy) - grid_position(x, y)))


def pair_key(source, dx, dy):
    x, y = cell_coord(source)
    target, (ox, oy) = in_cell(x + dx, y + dy)
    return min((source, target, ox, oy), (target, source, -ox, -oy))


def classify_bond(bond):
    length = bond_length(*bond)
    for level, (expected, _) in LEVELS.items():
        if abs(length - expected) < 1.0e-9:
            return level
    return None


# ---------------------------------------------------------------------------
# Running
# ---------------------------------------------------------------------------


def tool_command(env_name, default):
    """The command for a tool: the build tree's, or the one the environment
    variable env_name (TENES_TEST_TENES_SIMPLE / TENES_TEST_TENES_STD) sets,
    announced with a note so that the log shows what was run."""
    override = os.environ.get(env_name)
    if override:
        tool = "tenes_simple" if env_name == "TENES_TEST_TENES_SIMPLE" else "tenes_std"
        print(f"note: using {override} for {tool} ({env_name})", flush=True)
        return shlex.split(override)
    return [default]


def with_override_note(message):
    """A failure message, with the tool overrides in effect appended, so that
    a failure of a mutation run cannot be read as one of the real tools."""
    replaced = [
        f"{name}={os.environ[name]!r}"
        for name in TOOL_OVERRIDES
        if os.environ.get(name)
    ]
    if not replaced:
        return message
    return message + " [tool overrides in effect: " + ", ".join(replaced) + "]"


def run(cmd, cwd):
    print("run:", " ".join(cmd), flush=True)
    return subprocess.run(cmd, cwd=cwd, check=False, text=True, capture_output=True)


def run_tool(cmd, cwd):
    proc = run(cmd, cwd)
    if proc.returncode != 0:
        print(proc.stdout + proc.stderr)
        message = f"{NAME} failed: {' '.join(cmd)} exited with {proc.returncode}"
        print(with_override_note(message))
        return False
    return True


def launcher():
    cmd = []
    if "@MPIEXEC@":
        cmd.append("@MPIEXEC@")
        cmd.extend("@MPIEXEC_PREFLAGS@".split())
        cmd.append("@MPIEXEC_NUMPROC_FLAG@")
        cmd.append("1")
        cmd.extend("@MPIEXEC_POSTFLAGS@".split())
    return cmd


def parse_bonds(text):
    bonds = []
    for line in text.splitlines():
        words = line.split()
        if len(words) == 3:
            bonds.append(tuple(int(word) for word in words))
    return bonds


def parse_twosite(text):
    """op[in1, in2, out1, out2] of a two-site operator of std.toml."""
    op = np.zeros((D, D, D, D), dtype=complex)
    for line in text.splitlines():
        words = line.split()
        if len(words) == 6:
            i1, i2, o1, o2 = (int(word) for word in words[:4])
            op[i1, i2, o1, o2] += complex(float(words[4]), float(words[5]))
    return op


def parse_onesite(text):
    op = np.zeros((D, D), dtype=complex)
    for line in text.splitlines():
        words = line.split()
        if len(words) == 4:
            op[int(words[0]), int(words[1])] += complex(
                float(words[2]), float(words[3])
            )
    return op


def extend_std_toml(path, nnn_bonds):
    """Add "hopping_nnn": the elements of tenes_simple's "hopping" on the
    second-neighbour bonds.  Returns {name: group} of the one-site
    observables and the two hopping observables."""
    std = toml.load(path)
    twosite = std["observable"]["twosite"]
    hopping = [entry for entry in twosite if entry["name"] == "hopping"]
    group = max(entry["group"] for entry in twosite) + 1
    twosite.append(
        {
            "name": "hopping_nnn",
            "group": group,
            "dim": [D, D],
            "bonds": "\n".join(f"{s} {dx} {dy}" for s, dx, dy in sorted(nnn_bonds)),
            "elements": hopping[0]["elements"],
        }
    )
    with open(path, "w") as f:
        toml.dump(std, f)
    groups = {e["name"]: e["group"] for e in std["observable"]["onesite"]}
    groups["hopping"] = hopping[0]["group"]
    groups["hopping_nnn"] = group
    return groups


def read_rows(path):
    rows = []
    with open(path) as f:
        for line in f:
            line = line.split("#", 1)[0].strip()
            if line:
                rows.append([float(word) for word in line.split()])
    return rows


def read_density(path):
    values = []
    with open(path) as f:
        for line in f:
            if "=" not in line:
                continue
            name, raw = line.split("=", 1)
            words = raw.split()
            values.append((name.strip(), complex(float(words[0]), float(words[1]))))
    return values


# ---------------------------------------------------------------------------
# Checks
# ---------------------------------------------------------------------------


def check_std(std):
    """Returns (failures, {level: [bonds]})."""
    failures = []
    onesite = {e["name"]: e for e in std["observable"]["onesite"]}
    twosite = {e["name"]: e for e in std["observable"]["twosite"]}
    for name in ODD + ("n", "doublon"):
        if name not in onesite:
            failures.append(f"std.toml has no one-site observable {name!r}")
    if "hopping" not in twosite:
        failures.append("std.toml has no two-site observable 'hopping'")
    if failures:
        return failures, None

    # the diagonal part every bond has to carry
    n_op = parse_onesite(onesite["n"]["elements"])
    d_op = parse_onesite(onesite["doublon"]["elements"])
    for op, what in ((n_op, "n"), (d_op, "doublon")):
        if not np.allclose(op, np.diag(np.diag(op)), atol=0.0):
            failures.append(f"std.toml: {what} is not diagonal")
    local = (U * np.diag(d_op) - MU * np.diag(n_op)) / Z
    diagonal = np.zeros((D, D, D, D), dtype=complex)
    for i1 in range(D):
        for i2 in range(D):
            diagonal[i1, i2, i1, i2] = local[i1] + local[i2]
    hop_op = parse_twosite(twosite["hopping"]["elements"])
    if np.abs(hop_op).max() < 0.5:
        failures.append("std.toml: 'hopping' is empty")

    by_level = {level: [] for level in LEVELS}
    for ham in std.get("hamiltonian", []):
        op = parse_twosite(ham["elements"])
        for bond in parse_bonds(ham["bonds"]):
            level = classify_bond(bond)
            if level is None:
                failures.append(
                    f"std.toml: the Hamiltonian bond {bond} has length "
                    f"{bond_length(*bond):.6f}, not a honeycomb first or second "
                    f"neighbour distance"
                )
                continue
            by_level[level].append(bond)
            expected = -LEVELS[level][1] * hop_op + diagonal
            if not np.allclose(op, expected, atol=1.0e-12, rtol=0.0):
                failures.append(
                    f"std.toml: the matrix of the {level} bond {bond} is not "
                    f"-t_n hopping + (U / z)(D_s + D_t) - (mu / z)(n_s + n_t)"
                )
    for level, bonds in by_level.items():
        keys = [pair_key(*bond) for bond in bonds]
        if len(set(keys)) != len(keys):
            failures.append(f"std.toml: a {level} pair of sites appears twice")
        degree = np.zeros(NSITES, dtype=int)
        for source, target, _, _ in keys:
            degree[source] += 1
            degree[target] += 1
        if not np.all(degree == COORDINATION[level]):
            failures.append(
                f"std.toml: {level} bonds per site are {list(degree)}, not "
                f"{COORDINATION[level]} (the bonds are {sorted(bonds)})"
            )
    if sorted(parse_bonds(twosite["hopping"]["bonds"])) != sorted(by_level["NN"]):
        failures.append("std.toml: 'hopping' is not on the nearest-neighbour bonds")
    return failures, by_level


def check_input(input_param):
    failures = []
    if input_param["parameter"]["general"].get("fermion") is not True:
        failures.append("input.toml: parameter.general.fermion is not true")
    for ucell in input_param["tensor"]["unitcell"]:
        if ucell.get("parity") != [0, 1, 1, 0] or ucell.get("physical_dim") != D:
            failures.append(
                f"input.toml: unit cell {ucell.get('index')} has parity "
                f"{ucell.get('parity')}, physical_dim {ucell.get('physical_dim')}"
            )
    return failures


def check_warnings(output):
    failures = []
    # As in HubbardTriangular (and unlike the free-fermion tests, whose D = 3
    # CTM stops unconverged), the CTM of this D = 2 state converges (chi = 8),
    # so a non-converged CTM is a failure here.
    for pattern in ("CTM did not converge", "Norm is negative", "Norm is not real"):
        hits = [line.strip() for line in output.splitlines() if pattern in line]
        if hits:
            failures.append(f"tenes printed {hits[0]!r}")
    return failures


def check_odd_onesite_is_zero(outdir, groups):
    failures = []
    density = dict(read_density(join(outdir, "density.dat")))
    odd_groups = {groups[name] for name in ODD}
    for name in ODD:
        if name not in density:
            failures.append(f"density.dat has no {name} row")
        elif density[name] != 0.0:
            failures.append(f"density.dat: {name} = {density[name]}, must be exactly 0")
    seen = 0
    for group, site, re, im in read_rows(join(outdir, "onesite_obs.dat")):
        if int(group) in odd_groups:
            seen += 1
            if re != 0.0 or im != 0.0:
                failures.append(
                    f"onesite_obs.dat: group {int(group)} site {int(site)} is "
                    f"{re} + {im}i; an odd one-site operator must give exactly 0"
                )
    if seen != len(ODD) * NSITES:
        failures.append(f"onesite_obs.dat: {seen} rows of odd operators")
    return failures


def check_balance(outdir):
    failures = []
    density = dict(read_density(join(outdir, "density.dat")))
    for name in ("Energy", "hopping", "hopping_nnn", "doublon", "n"):
        if name not in density:
            return [f"density.dat has no {name} row"]
    energy = density["Energy"].real
    balance = (
        -T * density["hopping"].real
        - TPRIME * density["hopping_nnn"].real
        + U * density["doublon"].real
        - MU * density["n"].real
    )
    err = abs(energy - balance)
    print(f"{NAME}: energy {energy:.10f} against its parts {balance:.10f} ({err:.3e})")
    if not err <= ENV_TOL:
        failures.append(
            f"energy {energy} is not -t hopping - t' hopping_nnn + U doublon - mu n "
            f"= {balance} (|diff| {err:.3e} > {ENV_TOL:.3e})"
        )
    return failures


def check_hopping_signs(outdir, group, nn_bonds):
    failures = []
    table = {}
    for row in read_rows(join(outdir, "twosite_obs.dat")):
        g, source, dx, dy, re, im = row
        if int(g) == group:
            table[(int(source), int(dx), int(dy))] = complex(re, im)
    for sub, dx, dy in NN_DIRECTIONS:
        bonds = [b for b in nn_bonds if sublattice(b[0]) == sub and b[1:] == (dx, dy)]
        values = []
        for bond in bonds:
            if bond not in table:
                failures.append(f"twosite_obs.dat has no hopping row {bond}")
                continue
            value = table[bond].real
            values.append(value)
            if not value > 0.0:
                failures.append(
                    f"the hopping on the bond {bond} is {value}; it must be "
                    f"positive on every nearest-neighbour bond"
                )
        print(f"{NAME}: hopping of {sub} at {(dx, dy)} per bond: {values}")
        if not values:
            failures.append(f"no nearest-neighbour bond of {sub} at {(dx, dy)}")
            continue
        mean = float(np.mean(values))
        if not mean >= MIN_HOPPING:
            failures.append(
                f"the average hopping of {sub} at {(dx, dy)} is {mean}, below "
                f"{MIN_HOPPING}"
            )
    return failures


def compare_golden(outdir):
    failures = []
    for filename in GOLDEN_FILES:
        path_ref = join(GOLDEN_DIR, filename)
        if not os.path.exists(path_ref):
            failures.append(f"reference file is missing: {path_ref}")
            continue
        path_res = join(outdir, filename)
        if filename == "density.dat":
            res = [[v.real, v.imag] for _, v in read_density(path_res)]
            ref = [[v.real, v.imag] for _, v in read_density(path_ref)]
        else:
            res = read_rows(path_res)
            ref = read_rows(path_ref)
        if len(res) != len(ref):
            failures.append(
                f"{filename}: {len(res)} rows, the reference has {len(ref)}"
            )
            continue
        for index, (rrow, frow) in enumerate(zip(res, ref)):
            if len(rrow) != len(frow) or not np.all(
                np.isclose(rrow, frow, rtol=RTOL, atol=ATOL)
            ):
                failures.append(
                    f"{filename} row {index} differs from the golden file: "
                    f"{rrow} vs {frow}"
                )
    return failures


def report(failures):
    for message in failures:
        print(with_override_note(NAME + " failed: " + message))
    return 1


def main():
    work_dir = join("@CMAKE_CURRENT_BINARY_DIR@", "output_" + NAME)
    if os.path.isdir(work_dir):
        shutil.rmtree(work_dir)
    os.makedirs(work_dir)
    update_golden = os.environ.get(UPDATE_GOLDEN_ENV) == "1"
    overridden = [name for name in TOOL_OVERRIDES if os.environ.get(name)]
    if update_golden and overridden:
        print(f"{NAME}: refusing to write golden files with {overridden} set")
        return 1
    with open(join(work_dir, "simple.toml"), "w") as f:
        f.write(SIMPLE_TOML)

    simple = tool_command("TENES_TEST_TENES_SIMPLE", TENES_SIMPLE)
    std = tool_command("TENES_TEST_TENES_STD", TENES_STD)
    if not run_tool(simple + ["simple.toml", "-o", "std.toml"], work_dir):
        return 1
    std_path = join(work_dir, "std.toml")
    failures, by_level = check_std(toml.load(std_path))
    if failures:
        return report(failures)
    groups = extend_std_toml(std_path, by_level["NNN"])
    if not run_tool(std + ["std.toml", "-o", "input.toml"], work_dir):
        return 1
    failures = check_input(toml.load(join(work_dir, "input.toml")))
    if failures:
        return report(failures)

    proc = run(launcher() + [TENES, "input.toml"], work_dir)
    output = proc.stdout + proc.stderr
    with open(join(work_dir, "tenes.log"), "w") as f:
        f.write(output)
    if proc.returncode != 0:
        print(output)
        return report([f"tenes exited with {proc.returncode}"])
    outdir = join(work_dir, "output")

    failures += check_warnings(output)
    failures += check_odd_onesite_is_zero(outdir, groups)
    failures += check_balance(outdir)
    failures += check_hopping_signs(outdir, groups["hopping"], by_level["NN"])
    if failures:
        return report(failures)

    if update_golden:
        os.makedirs(GOLDEN_DIR, exist_ok=True)
        for filename in GOLDEN_FILES:
            shutil.copyfile(join(outdir, filename), join(GOLDEN_DIR, filename))
        print(f"{NAME}: golden files written to {GOLDEN_DIR}")
        return 0

    failures = compare_golden(outdir)
    if failures:
        return report(failures)
    return 0


if __name__ == "__main__":
    sys.exit(main())
