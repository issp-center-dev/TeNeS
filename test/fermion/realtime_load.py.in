# Section 5 of
# docs/superpowers/specs/2026-10-01-fermion-real-time-evolution-contract.md:
# real-time evolution started from a saved ground state.  One script, one
# case per ctest entry:
#
#   --case fermion-real     item 1: a fermion ground state computed with
#                           is_real = true and saved (tensor_save) is loaded
#                           (tensor_load) by a real-time run, which works in
#                           complex tensors
#   --case fermion-complex  items 2 and 3: the same with is_real = false; and
#                           that complex checkpoint loaded by an is_real =
#                           true ground-state run must be refused with a
#                           nonzero exit code and a message naming both
#                           "complex" and "is_real"
#   --case boson-real       item 4: the same as item 1 without fermion mode
#   --nproc 2               item 5: save and load on two MPI processes (ctest
#                           registers it for fermion-real and boson-real when
#                           the build has MPI)
#
# What is compared (items 1, 2, 4): the time-zero rows of TE_onesite_obs.dat
# and TE_twosite_obs.dat of the real-time run against onesite_obs.dat and
# twosite_obs.dat of the ground-state run that wrote the checkpoint.  Both
# runs use the mean-field environment, so the two measurements are the same
# computation on the same tensors and lambda weights.  The real-time run uses
# a different Hamiltonian (U = 0, mu = 0 for the fermions, hx = 0.5 for the
# spins) so that the evolution after time zero does something; the
# observables whose definition depends on the Hamiltonian (bond_hamiltonian)
# are therefore not compared, and every other observable is compared only
# after checking that the two input.toml files define it identically
# (observables are matched by name, since the real run of the spin model has
# no Sy and its group numbers are not those of the complex run).
#
# Tolerance: TOL = 1e-10 on |TE - ground state| and on the imaginary part of
# every time-zero value.  Measured on the calibration build
# (work/fermion-real-time/p0, which has no load fix) by converting the real
# checkpoint to a complex one by hand (mptensor header value_type 0 -> 1 and
# the binary data widened with zero imaginary parts) and loading that: the
# fermion values agreed to 0 (bit for bit) and the spin values to 2.8e-17; a
# complex checkpoint loaded by a complex run (item 2, which the calibration
# build can run) agreed bit for bit.  What a broken load gives is of order
# one: the calibration build reading the real spin checkpoint as complex
# reports <Sz> = 0.5 against the saved -0.39, and in fermion mode the parity
# check refuses the garbage outright.
#
# Before the implementation: items 1 and 4 fail (item 1 because the real-time
# run is refused when it reads the input - "non-ground-state mode" - and,
# with that guard lifted, because the loaded tensors "break fermion parity";
# item 4 aborts on an mptensor assertion in a Debug build and runs on with
# garbage in a Release build); item 2 fails on the input guard; item 3 aborts
# in a Debug build (a signal is not a clean nonzero exit) and in a Release
# build stops with the fermion parity message, which names neither "complex"
# nor "is_real".
import os
import shlex
import shutil
import subprocess
import sys
from os.path import join

import toml

TENES_SIMPLE = join("@CMAKE_BINARY_DIR@", "tool", "tenes_simple")
TENES_STD = join("@CMAKE_BINARY_DIR@", "tool", "tenes_std")
TENES = os.environ.get("TENES_TEST_TENES") or join("@CMAKE_BINARY_DIR@", "src", "tenes")
MPIEXEC = "@MPIEXEC@"

TOL = 1.0e-10
TIMEOUT = 600

GS_STEPS = 300
TE_STEPS = 20
TE_MEASURE_INTERVAL = 10

FERMION_LATTICE = """
[lattice]
type = "square lattice"
L = 2
W = 1
virtual_dim = 3
initial = "random"
"""

SPIN_LATTICE = """
[lattice]
type = "square lattice"
L = 2
W = 2
virtual_dim = 3
initial = "random"
"""


def fermion_model(U, mu):
    return f"""
[model]
type = "hubbard"
t = 1.0
U = {U}
mu = {mu}
"""


def spin_model(hx):
    return f"""
[model]
type = "spin"
S = 0.5
Jz = -1.0
hx = {hx}
"""


def gs_simple_toml(is_real, save_or_load, directory, lattice, model):
    return f"""
[parameter.general]
is_real = {"true" if is_real else "false"}
output = "output"
{save_or_load} = "{directory}"

[parameter.simple_update]
tau = 0.01
num_step = {GS_STEPS}

[parameter.full_update]
num_step = 0

[parameter.ctm]
meanfield_env = true

[parameter.random]
seed = 11
{lattice}
{model}
"""


def te_simple_toml(load_dir, lattice, model):
    return f"""
[parameter.general]
mode = "time"
is_real = false
output = "output"
tensor_load = "{load_dir}"
measure_interval = {TE_MEASURE_INTERVAL}

[parameter.simple_update]
tau = 0.01
num_step = {TE_STEPS}

[parameter.full_update]
num_step = 0

[parameter.ctm]
meanfield_env = true
{lattice}
{model}
"""


def launcher(nproc):
    cmd = []
    if MPIEXEC:
        cmd.append(MPIEXEC)
        cmd.extend("@MPIEXEC_PREFLAGS@".split())
        cmd.append("@MPIEXEC_NUMPROC_FLAG@")
        cmd.append(str(nproc))
        cmd.extend("@MPIEXEC_POSTFLAGS@".split())
    elif nproc != 1:
        raise RuntimeError("this build has no MPI launcher; --nproc must be 1")
    return cmd


def tool_command(env_name, default):
    override = os.environ.get(env_name)
    if override:
        print(f"note: using {override} ({env_name})", flush=True)
        return shlex.split(override)
    return [default]


def run(cmd, cwd):
    print("run:", " ".join(cmd), flush=True)
    try:
        return subprocess.run(
            cmd, cwd=cwd, check=False, text=True, capture_output=True, timeout=TIMEOUT
        )
    except subprocess.TimeoutExpired as e:
        raise RuntimeError(f"{' '.join(cmd)} did not finish in {TIMEOUT} s") from e


def must_succeed(proc, what):
    if proc.returncode != 0:
        print(proc.stdout[-4000:] + proc.stderr[-4000:])
        raise RuntimeError(f"{what} exited with {proc.returncode}")


def prepare(workdir, simple_text):
    """simple.toml -> tenes_simple -> tenes_std -> input.toml in workdir."""
    os.makedirs(workdir)
    with open(join(workdir, "simple.toml"), "w") as f:
        f.write(simple_text)
    simple = tool_command("TENES_TEST_TENES_SIMPLE", TENES_SIMPLE)
    must_succeed(run(simple + ["simple.toml"], workdir), f"tenes_simple in {workdir}")
    std = tool_command("TENES_TEST_TENES_STD", TENES_STD)
    must_succeed(run(std + ["std.toml"], workdir), f"tenes_std in {workdir}")


def run_tenes(workdir, nproc):
    return run(launcher(nproc) + [TENES, "input.toml"], workdir)


# ----------------------------------------------------------------------------
# reading
# ----------------------------------------------------------------------------


def group_names(path):
    """{group: name} from the '# The names of op_group' block of a .dat."""
    names = {}
    in_block = False
    with open(path) as f:
        for line in f:
            if not line.startswith("#"):
                break
            body = line[1:].strip()
            if body.startswith("The names of op_group"):
                in_block = True
                continue
            if in_block and ":" in body:
                key, name = body.split(":", 1)
                key = key.strip()
                if key.lstrip("-").isdigit():
                    names[int(key)] = name.strip()
    return names


def read_values(path, timed):
    """{(name, rest of the key...): complex}; time-zero rows only if timed."""
    names = group_names(path)
    out = {}
    with open(path) as f:
        for line in f:
            line = line.split("#", 1)[0].strip()
            if not line:
                continue
            words = [float(w) for w in line.split()]
            if timed:
                if words[0] != 0.0:
                    continue
                words = words[1:]
            group = int(words[0])
            name = "norm" if group == -1 else names.get(group, f"group{group}")
            key = (name,) + tuple(int(w) for w in words[1:-2])
            out[key] = complex(words[-2], words[-1])
    return out


def times_in(path):
    ts = set()
    with open(path) as f:
        for line in f:
            line = line.split("#", 1)[0].strip()
            if line:
                ts.add(round(float(line.split()[0]), 9))
    return sorted(ts)


def parse_elements(text):
    out = {}
    for line in text.strip().splitlines():
        words = line.split()
        if not words:
            continue
        n = len(words) - 2
        value = complex(float(words[n]), float(words[n + 1]))
        out[tuple(int(w) for w in words[:n])] = value
    return out


def definitions(input_toml):
    """{(kind, name): (where, {index: value})} of every observable.

    A two-site observable in the ops form is expanded into elements, with
    op[i1, i2, o1, o2] = A[i1, o1] B[i2, o2] (the convention noted in
    boson_equivalence_full.py.in, checked there against the SySy block of
    AntiferroHeisenberg_real.toml), so that the same operator written in the
    two forms compares equal: tenes_simple writes SySy with elements in a real
    run and as ops = [Sy, Sy] in a complex one."""
    param = toml.load(input_toml)
    obs = param.get("observable", {})
    onesite = obs.get("onesite", [])
    matrices = {}
    defs = {}
    for o in onesite:
        coeff = complex(o.get("coeff", 1.0), o.get("coeff_im", 0.0))
        elems = {k: coeff * v for k, v in parse_elements(o["elements"]).items()}
        matrices[o["group"]] = parse_elements(o["elements"])
        defs[("onesite", o["name"])] = (tuple(o.get("sites", [])), elems)
    for o in obs.get("twosite", []):
        coeff = complex(o.get("coeff", 1.0), o.get("coeff_im", 0.0))
        if "elements" in o:
            raw = parse_elements(o["elements"])
        else:
            a, b = (matrices[i] for i in o["ops"])
            raw = {}
            for (i1, o1), va in a.items():
                for (i2, o2), vb in b.items():
                    raw[(i1, i2, o1, o2)] = va * vb
        elems = {k: coeff * v for k, v in raw.items()}
        lines = o.get("bonds", "").splitlines()
        bonds = tuple(sorted(line.strip() for line in lines if line.strip()))
        defs[("twosite", o["name"])] = (bonds, elems)
    return defs


def same_definition(a, b):
    where_a, elems_a = a
    where_b, elems_b = b
    if where_a != where_b:
        return False
    for key in set(elems_a) | set(elems_b):
        if abs(elems_a.get(key, 0.0) - elems_b.get(key, 0.0)) > 1.0e-12:
            return False
    return True


def comparable_names(gs_dir, te_dir, kind, expected_differing):
    gs_defs = definitions(join(gs_dir, "input.toml"))
    te_defs = definitions(join(te_dir, "input.toml"))
    same, failures = set(), []
    for (k, name), d in gs_defs.items():
        if k != kind:
            continue
        if (k, name) not in te_defs:
            failures.append(f"the real-time input has no {kind} observable {name!r}")
        elif same_definition(te_defs[(k, name)], d):
            same.add(name)
        elif name not in expected_differing:
            failures.append(
                f"the {kind} observable {name!r} is defined differently in the "
                "ground-state and the real-time input; the fixture no longer "
                "compares like with like"
            )
    return same, failures


# ----------------------------------------------------------------------------
# checks
# ----------------------------------------------------------------------------


def checkpoint_value_type(save_dir):
    """'double' or 'complex' from the header of the saved T_0 (premise)."""
    with open(join(save_dir, "T_0.dat")) as f:
        for line in f:
            if line.startswith("value_type="):
                return "complex" if "complex" in line else "double"
    return None


def compare_time_zero(gs_dir, te_dir, expected_differing, nontrivial):
    failures = []
    for filename, kind in (
        ("onesite_obs.dat", "onesite"),
        ("twosite_obs.dat", "twosite"),
    ):
        same, fail = comparable_names(gs_dir, te_dir, kind, expected_differing)
        failures += fail
        if kind == "onesite":
            same.add("norm")
        gs = read_values(join(gs_dir, "output", filename), timed=False)
        te_path = join(te_dir, "output", "TE_" + filename)
        if not os.path.exists(te_path):
            failures.append(f"the real-time run wrote no TE_{filename}")
            continue
        te = read_values(te_path, timed=True)
        compared = 0
        worst = 0.0
        for key, value in gs.items():
            if key[0] not in same:
                continue
            if key not in te:
                failures.append(f"TE_{filename} has no time-zero value for {key}")
                continue
            compared += 1
            err = abs(te[key] - value)
            worst = max(worst, err, abs(te[key].imag))
            if not err <= TOL:
                failures.append(
                    f"TE_{filename} {key} at time 0 is {te[key]}, the ground-state "
                    f"run measured {value} (difference {err:.3e} > {TOL:g})"
                )
            if not abs(te[key].imag) <= TOL:
                failures.append(
                    f"TE_{filename} {key} at time 0 has imaginary part "
                    f"{te[key].imag:.3e}"
                )
        print(
            f"{filename}: compared {compared} values of {sorted(same)}, "
            f"worst {worst:.3e}"
        )
        if compared == 0:
            failures.append(f"{filename}: nothing was compared")
    # premise: the saved state is not trivial, so that equality means something
    gs = read_values(join(gs_dir, "output", "twosite_obs.dat"), timed=False)
    if not any(abs(v) > 1e-2 for k, v in gs.items() if k[0] == nontrivial):
        failures.append(
            f"the ground state has no {nontrivial} correlation; the fixture is "
            "trivial"
        )
    return failures


def check_completed(te_dir):
    want = [round(0.01 * k, 9) for k in range(0, TE_STEPS + 1, TE_MEASURE_INTERVAL)]
    got = times_in(join(te_dir, "output", "TE_onesite_obs.dat"))
    if got != want:
        return [
            f"the real-time run measured at {got}, expected {want}; it did not "
            "run to the end"
        ]
    return []


def save_then_evolve(workroot, nproc, *, fermion, is_real):
    failures = []
    lattice = FERMION_LATTICE if fermion else SPIN_LATTICE
    gs_model = fermion_model(4.0, 2.0) if fermion else spin_model(1.0)
    te_model = fermion_model(0.0, 0.0) if fermion else spin_model(0.5)
    gs_dir = join(workroot, "gs")
    te_dir = join(workroot, "te")
    prepare(gs_dir, gs_simple_toml(is_real, "tensor_save", "save", lattice, gs_model))
    must_succeed(run_tenes(gs_dir, nproc), "the ground-state run")
    want_type = "double" if is_real else "complex"
    got_type = checkpoint_value_type(join(gs_dir, "save"))
    if got_type != want_type:
        failures.append(
            f"the checkpoint holds {got_type} tensors, expected {want_type}"
        )
    if fermion and not os.path.exists(join(gs_dir, "save", "fermion.dat")):
        failures.append("the fermion checkpoint has no fermion.dat")

    prepare(te_dir, te_simple_toml(join("..", "gs", "save"), lattice, te_model))
    param = toml.load(join(te_dir, "input.toml"))
    if bool(param["parameter"]["general"].get("fermion", False)) != fermion:
        failures.append("the real-time input.toml has the wrong fermion setting")
    proc = run_tenes(te_dir, nproc)
    if proc.returncode != 0:
        print(proc.stdout[-4000:] + proc.stderr[-4000:])
        failures.append(
            f"the real-time run from the checkpoint exited with {proc.returncode}"
        )
        return failures
    failures += check_completed(te_dir)
    failures += compare_time_zero(
        gs_dir, te_dir, {"bond_hamiltonian"}, "hopping" if fermion else "SzSz"
    )
    return failures


def complex_into_real(workroot, nproc):
    """Item 3: the complex checkpoint of item 2 loaded by is_real = true."""
    failures = []
    rl_dir = join(workroot, "real_load")
    prepare(
        rl_dir,
        gs_simple_toml(
            True,
            "tensor_load",
            join("..", "gs", "save"),
            FERMION_LATTICE,
            fermion_model(4.0, 2.0),
        ),
    )
    proc = run_tenes(rl_dir, nproc)
    text = proc.stdout + proc.stderr
    print(f"is_real = true run on a complex checkpoint: exit {proc.returncode}")
    print("\n".join(text.strip().splitlines()[-6:]))
    if proc.returncode == 0:
        failures.append(
            "an is_real = true run loaded a complex checkpoint without an error"
        )
    elif proc.returncode < 0 or proc.returncode >= 128:
        # < 0: killed by a signal; >= 128: the same seen through mpiexec,
        # which reports 128 + the signal number (134 for an abort)
        failures.append(
            f"the is_real = true run on a complex checkpoint died on a signal "
            f"(exit {proc.returncode}) instead of stopping with an error message"
        )
    # The banner line "Tensor type: ..." is not an error message; leave it out
    # so that it cannot supply the word "complex".
    message = "\n".join(
        line for line in text.splitlines() if not line.strip().startswith("Tensor type")
    )
    for word in ("complex", "is_real"):
        if word not in message:
            failures.append(
                f"the error for a complex checkpoint loaded with is_real = true "
                f"does not mention {word!r}"
            )
    return failures


CASES = {
    "fermion-real": "FermionRealTimeLoadReal",
    "fermion-complex": "FermionRealTimeLoadComplex",
    "boson-real": "BosonRealTimeLoadReal",
}


def main(argv):
    if "--case" not in argv or argv[argv.index("--case") + 1] not in CASES:
        print("usage: --case " + "|".join(CASES) + " [--nproc N]")
        return 2
    case = argv[argv.index("--case") + 1]
    nproc = int(argv[argv.index("--nproc") + 1]) if "--nproc" in argv else 1
    label = CASES[case] + (f"MPI{nproc}" if nproc != 1 else "")
    workroot = os.path.abspath("output_" + label)
    if os.path.exists(workroot):
        shutil.rmtree(workroot)
    os.makedirs(workroot)
    try:
        if case == "fermion-real":
            failures = save_then_evolve(workroot, nproc, fermion=True, is_real=True)
        elif case == "boson-real":
            failures = save_then_evolve(workroot, nproc, fermion=False, is_real=True)
        else:
            failures = save_then_evolve(workroot, nproc, fermion=True, is_real=False)
            failures += complex_into_real(workroot, nproc)
    except RuntimeError as e:
        failures = [str(e)]
    if failures:
        for message in failures:
            print(f"{label} failed: {message}")
        return 1
    print(f"{label} passed")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
