# The gauge fixing of the simple update ([parameter.simple_update]
# gauge_fix = true) on a bond with fewer nonzero Schmidt values than its
# dimension.
#
# fix_local_gauge diagonalizes the boundary tensors of the two ends of a
# bond and divides by the square roots of their eigenvalues. On such a bond
# an eigenvalue is zero, the division used to give inf, the tensors filled
# with NaN, and the run ended in the environment update with an error of
# BLAS (issue #123).
#
# Both cases start from a product state, on which every bond has one
# nonzero Schmidt value.

import math
import os
import shutil
import subprocess
import sys
from os.path import join

os.environ["OMP_NUM_THREADS"] = "1"

WORKDIR = join("@CMAKE_CURRENT_BINARY_DIR@", "gauge_fix_rank_deficient_work")

HEISENBERG = """
0 0 0 0 0.25 0.0
0 1 0 1 -0.25 0.0
1 0 1 0 -0.25 0.0
1 1 1 1 0.25 0.0
0 1 1 0 0.5 0.0
1 0 0 1 0.5 0.0
"""

# The antiferromagnetic Heisenberg model on the square lattice, from the
# Neel state without noise.
NEEL = """\
[parameter]
[parameter.general]
is_real = true
[parameter.simple_update]
num_step = 100
tau = 0.01
gauge_fix = {gauge_fix}
[parameter.ctm]
iteration_max = 100
dimension = 9

[correlation_length]
measure = false

[tensor]
L_sub = [2, 2]

[[tensor.unitcell]]
index = [0, 3]
physical_dim = 2
virtual_dim = 3
initial_state = [1.0, 0.0]
noise = 0.0

[[tensor.unitcell]]
index = [1, 2]
physical_dim = 2
virtual_dim = 3
initial_state = [0.0, 1.0]
noise = 0.0

[[hamiltonian]]
dim = [2, 2]
bonds = \"\"\"
0 1 0
0 0 1
1 1 0
1 0 1
2 1 0
2 0 1
3 1 0
3 0 1
\"\"\"
elements = \"\"\"{elements}\"\"\"

[observable]
[[observable.onesite]]
name = "Sz"
group = 1
sites = []
dim = 2
elements = \"\"\"
0 0 0.5 0.0
1 1 -0.5 0.0
\"\"\"
"""

# Decoupled dimers in a field at a finite temperature. The run starts from
# the identity, and the horizontal bonds, which no term of the Hamiltonian
# uses, never get a second Schmidt value. lambda_cutoff is the one that
# takes a numerically zero lambda for zero: with the smaller 1e-12 such a
# lambda, of about 1e-8, is inverted, the eigenvalue is not zero, and the
# division goes through.
DIMERS = """\
[parameter]
[parameter.general]
mode = "finite"
measure_interval = 50
is_real = true
[parameter.simple_update]
num_step = 50
tau = 0.01
gauge_fix = true
lambda_cutoff = 1e-7
[parameter.ctm]
iteration_max = 100
dimension = 16

[tensor]
L_sub = [2, 2]

[[tensor.unitcell]]
index = []
physical_dim = 2
virtual_dim = 4

[[hamiltonian]]
dim = [2]
sites = []
elements = \"\"\"
0 0 -0.15 0.0
1 1 0.15 0.0
\"\"\"

[[hamiltonian]]
dim = [2, 2]
bonds = \"\"\"
0 0 1
1 0 1
\"\"\"
elements = \"\"\"{elements}\"\"\"
"""


def dimer_energy(beta, h):
    """Energy per site of S.S - h (S^z_1 + S^z_2)."""
    levels = [-0.75, 0.25 - h, 0.25, 0.25 + h]
    weights = [math.exp(-beta * e) for e in levels]
    return sum(e * w for e, w in zip(levels, weights)) / sum(weights) / 2


def setup_failure(msg):
    """A failure before the checks proper (a defect of the test rig)."""
    print("SETUP FAILURE: {}".format(msg))
    sys.exit(1)


def run_case(casename, std_toml):
    """Returns the exit code of tenes and its output directory."""
    casedir = join(WORKDIR, casename)
    os.makedirs(casedir)
    with open(join(casedir, "std.toml"), "w") as f:
        f.write(std_toml)
    cmd = [join("@CMAKE_BINARY_DIR@", "tool", "tenes_std"), "-o", "input.toml"]
    cmd.append("std.toml")
    print("+ " + " ".join(cmd))
    if subprocess.call(cmd, cwd=casedir) != 0:
        setup_failure("tenes_std failed for {}".format(casename))
    cmd = []
    if "@MPIEXEC@":
        cmd.append("@MPIEXEC@")
        cmd.extend("@MPIEXEC_PREFLAGS@".split())
        cmd.append("@MPIEXEC_NUMPROC_FLAG@")
        cmd.append("1")
        cmd.extend("@MPIEXEC_POSTFLAGS@".split())
    cmd.append(join("@CMAKE_BINARY_DIR@", "src", "tenes"))
    cmd.append("input.toml")
    print("+ " + " ".join(cmd))
    return subprocess.call(cmd, cwd=casedir), join(casedir, "output")


def ground_state_energy(outdir):
    with open(join(outdir, "density.dat")) as f:
        for line in f:
            name, _, values = line.partition("=")
            if name.strip() == "Energy":
                return float(values.split()[0])
    return float("nan")


def finite_temperature_energy(outdir):
    """The inverse temperature and the energy (observable 0) of the last
    measurement."""
    beta, energy = float("nan"), float("nan")
    with open(join(outdir, "FT_density.dat")) as f:
        for line in f:
            words = line.split()
            if len(words) == 4 and words[1] == "0":
                beta, energy = float(words[0]), float(words[2])
    return beta, energy


def close(casename, energy, expected, tol):
    # not (diff <= tol): a nan must fail
    if not abs(energy - expected) <= tol:
        print(
            "{}: the energy is {}, expected {}".format(casename, energy, expected)
        )
        return False
    print("{}: OK".format(casename))
    return True


def neel():
    # The gauge fixing changes the gauge and not the state: the energy is
    # that of the same run without it, up to what the two leave of the
    # round-off (1e-6 here).
    energies = {}
    for gauge_fix in ("false", "true"):
        casename = "neel_gauge_fix_" + gauge_fix
        std_toml = NEEL.format(gauge_fix=gauge_fix, elements=HEISENBERG)
        code, outdir = run_case(casename, std_toml)
        if code != 0:
            if gauge_fix == "false":
                setup_failure("the reference run without gauge fixing failed")
            print("{}: tenes exited with code {}".format(casename, code))
            return False
        energies[gauge_fix] = ground_state_energy(outdir)
    return close("neel_gauge_fix_true", energies["true"], energies["false"], 1e-4)


def dimers():
    code, outdir = run_case("dimers", DIMERS.format(elements=HEISENBERG))
    if code != 0:
        print("dimers: tenes exited with code {}".format(code))
        return False
    beta, energy = finite_temperature_energy(outdir)
    # the Trotter error of the dimer is below 1e-8 at tau = 0.01
    return close("dimers", energy, dimer_energy(beta, 0.3), 1.0e-6)


def main():
    if os.path.exists(WORKDIR):
        shutil.rmtree(WORKDIR)
    os.makedirs(WORKDIR)

    result = True
    result = neel() and result
    result = dimers() and result

    sys.exit(0 if result else 1)


if __name__ == "__main__":
    main()
