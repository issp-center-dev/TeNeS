# What density.dat reports must be the observables of the input.
#
# Every case is a ferromagnetic S = 1/2 Heisenberg chain, two sites in the
# unit cell, in a field along z where the case has one. The fully polarized
# product state is the exact ground state, the run starts from it, and every
# expectation value is known in closed form: -1/4 on a bond, and -h/2 on a
# site with the field term -h S^z.

import os
import shutil
import subprocess
import sys
from os.path import join

os.environ["OMP_NUM_THREADS"] = "1"

TOL = 1.0e-6

WORKDIR = join("@CMAKE_CURRENT_BINARY_DIR@", "observable_density_work")

HEAD = """\
[parameter]
[parameter.general]
is_real = true
[parameter.simple_update]
num_step = 100
tau = 0.1
[parameter.ctm]
dimension = 4
iteration_max = 100

[correlation_length]
measure = false

[tensor]
L_sub = [2, 1]

[[tensor.unitcell]]
index = []
physical_dim = 2
virtual_dim = [2, 1, 2, 1]
initial_state = [1.0, 0.0]
noise = 0.01
"""

SZ = """
0 0 0.5 0.0
1 1 -0.5 0.0
"""


def field(h, sites="[]"):
    """-h S^z on the given sites."""
    return """
[[hamiltonian]]
dim = [2]
sites = {sites}
elements = \"\"\"
0 0 {up} 0.0
1 1 {down} 0.0
\"\"\"
""".format(sites=sites, up=-0.5 * h, down=0.5 * h)


def bond_term(elements, bonds="0 1 0\n1 1 0"):
    return """
[[hamiltonian]]
dim = [2, 2]
bonds = \"\"\"
{bonds}
\"\"\"
elements = \"\"\"{elements}\"\"\"
""".format(bonds=bonds, elements=elements)


# -S.S = -S^z S^z - (S^+ S^- + S^- S^+) / 2
ISING = """
0 0 0 0 -0.25 0.0
0 1 0 1 0.25 0.0
1 0 1 0 0.25 0.0
1 1 1 1 -0.25 0.0
"""
XY = """
0 1 1 0 -0.5 0.0
1 0 0 1 -0.5 0.0
"""
HEISENBERG = ISING + XY.lstrip("\n")


def scaled(elements, factor):
    """The elements of factor times the operator."""
    lines = []
    for line in elements.strip().splitlines():
        words = line.split()
        words[-2] = repr(factor * float(words[-2]))
        lines.append(" ".join(words))
    return "\n" + "\n".join(lines) + "\n"


def sz_observable():
    return """
[[observable.onesite]]
name = "Sz"
group = 1
sites = []
dim = 2
elements = \"\"\"{}\"\"\"
""".format(SZ)


def szszsz_observable(coeff, multisites="0 1 0 2 0\n1 1 0 2 0"):
    """coeff S^z S^z S^z on three sites in a row."""
    return """
[[observable.multisite]]
name = "SzSzSz"
group = 0
coeff = {coeff}
multisites = \"\"\"
{multisites}
\"\"\"
ops = [1, 1, 1]
""".format(coeff=coeff, multisites=multisites)


def setup_failure(msg):
    """A failure before the checks proper (a defect of the test rig)."""
    print("SETUP FAILURE: {}".format(msg))
    sys.exit(1)


def prepare(casename, std_toml):
    """Write std.toml and make input.toml of it."""
    casedir = join(WORKDIR, casename)
    os.makedirs(casedir)
    with open(join(casedir, "std.toml"), "w") as f:
        f.write(std_toml)
    cmd = [join("@CMAKE_BINARY_DIR@", "tool", "tenes_std"), "-o", "input.toml"]
    cmd.append("std.toml")
    print("+ " + " ".join(cmd))
    ret = subprocess.call(cmd, cwd=casedir)
    if ret != 0:
        setup_failure("tenes_std exited with code {}".format(ret))
    return casedir


def run_tenes(casedir):
    """Run tenes; returns the exit code and what it wrote to stderr."""
    cmd = []
    if "@MPIEXEC@":
        cmd.append("@MPIEXEC@")
        cmd.extend("@MPIEXEC_PREFLAGS@".split())
        cmd.append("@MPIEXEC_NUMPROC_FLAG@")
        cmd.append("1")
        cmd.extend("@MPIEXEC_POSTFLAGS@".split())
    cmd.append(join("@CMAKE_BINARY_DIR@", "src", "tenes"))
    cmd.append("input.toml")
    print("+ " + " ".join(cmd))
    proc = subprocess.run(
        cmd, cwd=casedir, stderr=subprocess.PIPE, universal_newlines=True
    )
    sys.stderr.write(proc.stderr)
    return proc.returncode, proc.stderr


def read_density(casedir):
    """density.dat as {name: real part}."""
    ret = {}
    with open(join(casedir, "output", "density.dat")) as f:
        for line in f:
            name, _, values = line.partition("=")
            ret[name.strip()] = float(values.split()[0])
    return ret


def check_density(casename, std_toml, expected):
    """Run the case; density.dat must hold exactly the expected values."""
    casedir = prepare(casename, std_toml)
    code, _ = run_tenes(casedir)
    if code != 0:
        print("{}: tenes exited with code {}".format(casename, code))
        return False
    density = read_density(casedir)
    ok = True
    if sorted(density) != sorted(expected):
        print(
            "{}: density.dat has {}, expected {}".format(
                casename, sorted(density), sorted(expected)
            )
        )
        ok = False
    for name, value in expected.items():
        # not (diff <= TOL): a nan must fail
        if name in density and not abs(density[name] - value) <= TOL:
            print(
                "{}: {} is {}, expected {}".format(
                    casename, name, density[name], value
                )
            )
            ok = False
    if ok:
        print("{}: OK".format(casename))
    return ok


def check_rejected(casename, std_toml, message):
    """tenes must stop with an error that says why, not die on a signal."""
    return check_rejected_in(casename, prepare(casename, std_toml), message)


def check_rejected_in(casename, casedir, message, before_the_calculation=False):
    """before_the_calculation: the error must come when the input is read.
    tenes makes the output directory after that and before anything else."""
    code, stderr = run_tenes(casedir)
    ok = True
    if code <= 0:
        # 0: accepted; negative: killed by a signal
        print("{}: tenes exited with code {}".format(casename, code))
        ok = False
    if message not in stderr:
        print("{}: the error does not say '{}'".format(casename, message))
        ok = False
    if os.path.exists(join(casedir, "output", "density.dat")):
        print("{}: density.dat is written all the same".format(casename))
        ok = False
    if before_the_calculation and os.path.exists(join(casedir, "output")):
        print("{}: the calculation was started".format(casename))
        ok = False
    if ok:
        print("{}: OK".format(casename))
    return ok


def rewrite_input(casedir, old, new):
    """Replace old, which must be there once, in input.toml."""
    with open(join(casedir, "input.toml")) as f:
        input_toml = f.read()
    if input_toml.count(old) != 1:
        setup_failure("input.toml is not what this case expects")
    with open(join(casedir, "input.toml"), "w") as f:
        f.write(input_toml.replace(old, new))


def no_onesite_observable():
    # Bond terms only, and no [observable]: the input of tenes has no
    # one-site observable at all.
    return check_density(
        "no_onesite_observable",
        HEAD + bond_term(HEISENBERG),
        {"Energy": -0.25, "bond_hamiltonian": -0.25},
    )


def observable_on_some_sites():
    # The field and S^z on site 0 only. A density is the sum over the sites
    # that have the operator, divided by the number of sites of the cell, as the sum
    # over the bonds is; the Energy is then the energy per site.
    std_toml = HEAD + field(1.0, sites="[0]") + bond_term(HEISENBERG)
    std_toml += """
[observable]
[[observable.onesite]]
name = "Sz"
group = 1
sites = [0]
dim = 2
elements = \"\"\"{}\"\"\"
""".format(SZ)
    return check_density(
        "observable_on_some_sites",
        std_toml,
        {
            "Energy": -0.5,
            "site_hamiltonian": -0.25,
            "Sz": 0.25,
            "bond_hamiltonian": -0.25,
        },
    )


def terms_on_the_same_site_and_bond():
    # The field as two terms on the same sites, and the bond term as two
    # terms on the same bonds: they add up. A quarter and three quarters,
    # so that neither the first term alone nor the last gives the sum. (The
    # Ising part and the XY part would not do: the XY part is zero in the
    # polarized state.)
    std_toml = HEAD + field(0.25) + field(0.75)
    std_toml += bond_term(scaled(HEISENBERG, 0.25))
    std_toml += bond_term(scaled(HEISENBERG, 0.75))
    return check_density(
        "terms_on_the_same_site_and_bond",
        std_toml,
        {"Energy": -0.75, "site_hamiltonian": -0.5, "bond_hamiltonian": -0.25},
    )


def multisite_terms_on_the_same_sites():
    # S^z S^z S^z on three sites in a row, a quarter and three quarters of
    # it: 1/8 from each of the two sites, over two sites.
    std_toml = HEAD + bond_term(HEISENBERG)
    std_toml += "\n[observable]\n" + sz_observable()
    std_toml += szszsz_observable(0.25) + szszsz_observable(0.75)
    return check_density(
        "multisite_terms_on_the_same_sites",
        std_toml,
        {
            "Energy": -0.25,
            "Sz": 0.5,
            "bond_hamiltonian": -0.25,
            "SzSzSz": 0.125,
        },
    )


def product_of_an_operator_given_twice():
    # S^z is given as two halves, so "the" operator of group 1 that ops
    # refers to is not one operator.
    std_toml = HEAD + bond_term(HEISENBERG)
    std_toml += """
[observable]
"""
    for _ in range(2):
        std_toml += """
[[observable.onesite]]
name = "Sz"
group = 1
sites = []
dim = 2
coeff = 0.5
elements = \"\"\"{}\"\"\"
""".format(SZ)
    std_toml += """
[[observable.twosite]]
name = "SzSz"
group = 1
dim = [2, 2]
bonds = \"\"\"
0 1 0
\"\"\"
ops = [1, 1]
"""
    return check_rejected(
        "product_of_an_operator_given_twice", std_toml, "more than once"
    )


def observable_out_of_range():
    # A bond of four lattice spacings does not fit into the 4 x 4 window of
    # the measurement, and the energy without it is not the energy of the
    # input. tenes_std rejects such an observable itself, so it is written
    # into input.toml here. tenes must refuse it when it reads the input,
    # not when it comes to measure it after the whole calculation.
    casename = "observable_out_of_range"
    casedir = prepare(casename, HEAD + bond_term(HEISENBERG))
    in_range = 'name = "bond_hamiltonian"\ngroup = 0\nbonds = """\n0 1 0\n'
    rewrite_input(casedir, in_range, in_range.replace("0 1 0", "0 4 0"))
    return check_rejected_in(
        casename, casedir, "cannot be measured", before_the_calculation=True
    )


def multisite_observable_out_of_range():
    # The same for three sites that span five lattice spacings.
    casename = "multisite_observable_out_of_range"
    std_toml = HEAD + bond_term(HEISENBERG)
    std_toml += "\n[observable]\n" + sz_observable()
    std_toml += szszsz_observable(1.0, multisites="0 1 0 2 0")
    casedir = prepare(casename, std_toml)
    rewrite_input(casedir, "\n0 1 0 2 0\n", "\n0 1 0 4 0\n")
    return check_rejected_in(
        casename, casedir, "cannot be measured", before_the_calculation=True
    )


def main():
    if os.path.exists(WORKDIR):
        shutil.rmtree(WORKDIR)
    os.makedirs(WORKDIR)

    result = True
    result = no_onesite_observable() and result
    result = observable_on_some_sites() and result
    result = terms_on_the_same_site_and_bond() and result
    result = multisite_terms_on_the_same_sites() and result
    result = product_of_an_operator_given_twice() and result
    result = observable_out_of_range() and result
    result = multisite_observable_out_of_range() and result

    sys.exit(0 if result else 1)


if __name__ == "__main__":
    main()
